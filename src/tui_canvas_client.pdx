// src/tui_canvas_client.pdx -- postui.M1-001 scaffold
//                              (paideia-os/postui#1)
//
// TuiCanvasClient module: placeholder for the KIND_TUI_CANVAS client
// bindings landing at M1-004.
//
// docs/design.md §2.1 defines the KIND_TUI_CANVAS cap kind and its
// op set (TUI_OP_PRESENT, TUI_OP_QUERY_ROWS, TUI_OP_QUERY_COLS,
// TUI_OP_QUERY_ID, TUI_OP_QUERY_TTY_ID, TUI_OP_RESIZE, TUI_OP_CLEAR,
// TUI_OP_DEBUG_PRINT). This module wraps sys_cap_invoke against a
// canvas cap slot so higher-level modules (Frame at M1-005) do not
// re-encode the raw (rights, target_ptr, op_arg) triple every call.
//
// M1-004 lands the wrapper bodies (call site + errno translation).
// M1-001 seeds the ordinal + rights constants downstream modules can
// reference statically; the wire-format ordinal for KIND_TUI_CANVAS
// itself (0x1A6 per docs/design.md §2.1) is pinned here so it is
// authoritative in exactly one place inside the library. This is
// the same discipline shell/src/shell.pdx applies for the SH_KIND_*
// ordinal mirrors it exports.

module TuiCanvasClient = structure {

  // ==========================================================================
  // KIND ordinal mirror
  //
  // Mirror of the authoritative kernel value assigned at docs/
  // design.md §2.1 Cap model. The paideia-os R89.M1-001 landing
  // (kind_tui_canvas.pdx) will freeze this value; libpdx-cap's
  // caps.decl parser accepts either the symbolic name or this
  // numeric mirror at bind time.
  // ==========================================================================

  pub let TCC_KIND_TUI_CANVAS : u64 = 0x1A6

  // ==========================================================================
  // Op ordinals (docs/design.md §2.1 Ops table)
  // ==========================================================================

  pub let TCC_OP_PRESENT       : u64 = 0
  pub let TCC_OP_QUERY_ROWS    : u64 = 1
  pub let TCC_OP_QUERY_COLS    : u64 = 2
  pub let TCC_OP_QUERY_ID      : u64 = 3
  pub let TCC_OP_QUERY_TTY_ID  : u64 = 4
  pub let TCC_OP_RESIZE        : u64 = 5
  pub let TCC_OP_CLEAR         : u64 = 6
  pub let TCC_OP_DEBUG_PRINT   : u64 = 7

  // ==========================================================================
  // Rights bits (docs/design.md §2.1 Rights table)
  // ==========================================================================

  pub let TCC_R_TUI_PRESENT : u64 = 0x002
  pub let TCC_R_TUI_INVOKE  : u64 = 0x008
  pub let TCC_R_TUI_RESIZE  : u64 = 0x010
  pub let TCC_R_TUI_REVOKE  : u64 = 0x020
  pub let TCC_R_TUI_MINT    : u64 = 0x200
  pub let TCC_R_TUI_OBSERVE : u64 = 0x400
  pub let TCC_R_TUI_ALL     : u64 = 0x63A

  // ==========================================================================
  // Kernel-side failure band (mirrors kind_tui_canvas.pdx verbatim).
  //
  // The docs/design.md value (0xFFFFEC40..0xFFFFEC4F) collided with
  // KIND_NVME_CONTROLLER's page; the real kernel landing moved to a
  // verified-free page (see src/kernel/core/cap/kind_tui_canvas.pdx
  // deviation (1)) at 0xFFFFEB10..0xFFFFEB1F. This mirror is the
  // authoritative userspace-visible copy; every sentinel below is
  // byte-for-byte identical to its TUI_* counterpart in
  // kind_tui_canvas.pdx (lines 104-113). postui's own userspace-side
  // band (Lib::POSTUI_ERR_BAND_BASE = 0xFFFFEB80) is disjoint from
  // both this page and KIND_SIG_KEY's 0xFFFFEB00..0F, so a return
  // can be attributed to postui, KIND_TUI_CANVAS kernel, or KIND_TTY
  // kernel by inspection.
  // ==========================================================================

  pub let TCC_ERR_BAND_BASE : u64 = 0xFFFFEB10
  pub let TCC_ERR_BAND_TOP  : u64 = 0xFFFFEB1F

  pub let TCC_OK                  : u64 = 0
  pub let TCC_ERR_TAIL_ENOSPC     : u64 = 0xFFFFEB1F
  pub let TCC_ERR_MINT_BAD_MEMORY : u64 = 0xFFFFEB1E
  pub let TCC_ERR_MINT_BAD_TTY    : u64 = 0xFFFFEB1D
  pub let TCC_ERR_MINT_BAD_DIMS   : u64 = 0xFFFFEB1C
  pub let TCC_ERR_MINT_BAD_SIZE   : u64 = 0xFFFFEB1B
  pub let TCC_ERR_BAD_SLOT        : u64 = 0xFFFFEB1A
  pub let TCC_ERR_BAD_RIGHTS      : u64 = 0xFFFFEB19
  pub let TCC_ERR_REVOKE_ALREADY  : u64 = 0xFFFFEB18

  // ==========================================================================
  // SC+ sysno mirror -- sys_cap_invoke = 4 (design/user/syscall-table.md
  // row 4, paideia-os). Held here as a named constant so the eight
  // wrappers below name the SysV/SYSCALL entrance in exactly one place,
  // matching syscall.pdx's SYS_* discipline in shell/src/syscall.pdx and
  // syscall_shim.pdx's own naming of SC+ IDs.
  // ==========================================================================

  pub let TCC_SYS_CAP_INVOKE : u64 = 4

  // ==========================================================================
  // KIND_TUI_CANVAS OP WRAPPERS
  //
  // Contract: each wrapper below issues sys_cap_invoke(canvas_cap,
  // op_ordinal) directly and returns the kernel's u64 verbatim -- 0 (or
  // an op-specific u64 payload for QUERY ops) on success, one of the
  // TCC_ERR_* codes above on refusal (or the reserved
  // INVOKE_RESULT_INVALID_HANDLE = 0xFFFFFFFFFFFFFFFE if canvas_cap does
  // not name a live KIND_TUI_CANVAS row -- src/kernel/core/cap/invoke.pdx
  // cap_invoke's own out-of-range gate). No errno translation is
  // performed here: postui's higher layers (Frame at M1-005) already
  // read TCC_ERR_* directly for their own dispatch, matching the same
  // "raw kernel u64 through" convention shell/src/syscall.pdx applies.
  //
  // Per-wrapper calling convention. The kernel's sys_cap_invoke
  // (syscall_shim.pdx line 63) is a two-arg SysV wrapper -- rdi=slot,
  // rsi=op_arg -- and cap_handler_tui_canvas (R89.M1-002) currently
  // dispatches on op_arg treated as an 8-bit op ordinal directly (a full
  // u64 cmp against 0..7; any non-zero upper bits fall through to
  // TUI_BAD_SLOT). ALL EIGHT wrappers below are NULLARY (arity-1,
  // canvas_cap only) as of the postui#41 fix. PRESENT/QUERY_ROWS/
  // QUERY_COLS/QUERY_ID/QUERY_TTY_ID land against real kernel bodies
  // (R89.M1-002/003). RESIZE/CLEAR/DEBUG_PRINT invoke rights-checked
  // kernel stubs that return 0 (R89.M1-002 lines 154-168 / 170-182)
  // and are semantically no-ops at the current tip; their payload
  // delivery (rows/cols for RESIZE, 16-byte cell for CLEAR, ptr+len
  // for DEBUG_PRINT) is DEFERRED to a follow-up landing that mints a
  // per-canvas KIND_MEMORY scratch region at cap-mint time and uses
  // it as the side-channel between client and kernel handler, since
  // the frozen sys_cap_invoke ABI cannot carry those bytes. See the
  // FROZEN 2-ARG sys_cap_invoke ABI class comment immediately before
  // tcc_resize below for the full ADR (postui#41).
  //
  // Mint is DEFERRED. KIND_TUI_CANVAS_MINT is a KIND_CAP_TABLE-level
  // mint op (paideia-os R89.M1-001 kind_tui_canvas_mint_body, invoked
  // via cap_mint_write against a KIND_MEMORY parent + KIND_TTY tty_slot
  // -- see kind_tui_canvas.pdx lines 506-619). That path is the SHELL /
  // TOOL CALLER's responsibility, mediated by the caller's own libpdx-
  // cap linkage; postui only invokes ops on an already-minted canvas cap
  // handed to Frame (M1-005). This is the same posture shell/src/
  // session.pdx takes for KIND_IPC_ENDPOINT: the shell mints, higher
  // layers only invoke.
  //
  // Encoder pitfalls avoided:
  //   - All immediates fit imm32 (0..7 for op ordinals, 4 for SC+ ID);
  //     no imm64 staging via r11 needed.
  //   - r11 is left untouched (paideia-as reserves it; and SYSCALL
  //     clobbers it as return-address slot on the CPU side, which is
  //     harmless because no caller relies on r11 across a SYSCALL).
  //   - No `test` mnemonic; no zero-checks in these bodies (the caller
  //     inspects the return value against TCC_OK / TCC_ERR_*).
  //   - Every wrapper is a LEAF -- no push/pop, no local frame, no
  //     nested call -- so rsp%16 stays whatever the caller entered with;
  //     mirrors syscall_shim.pdx / syscall.pdx exactly.
  //   - Reserved labels: none (bodies are linear, no jumps).
  // ==========================================================================

  // tcc_present(canvas_cap) -> u64
  //
  // TUI_OP_PRESENT = 0. Rights: R_TUI_PRESENT (TCC_R_TUI_PRESENT =
  // 0x002). Nullary. Flushes the mapped back buffer through the kernel's
  // back-vs-front diff, emits the resulting ANSI cursor/SGR/glyph bytes
  // to the bound TTY sink, and commits back->front for the emitted rows.
  // Returns 0 on success or a TCC_ERR_BAD_* sentinel from the 0xFFFFEB1x
  // band (TUI_BAD_SLOT for a dead/out-of-range row, TUI_BAD_RIGHTS for a
  // rights-checked refusal). See cap_handler_tui_canvas.pdx tuih_op_
  // present + core/tui/canvas_present.pdx tui_present_body (paideia-os
  // R89.M1-003).
  pub let tcc_present : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui.M1-004 (postui#4): TUI_OP_PRESENT (0) wrapper. SysV rdi=canvas_cap passes through as SYSCALL rdi=slot. rsi is loaded with the op ordinal 0 (TCC_OP_PRESENT); rax is loaded with SC+ ID 4 (TCC_SYS_CAP_INVOKE, sys_cap_invoke per design/user/syscall-table.md row 4, paideia-os). No arg shuffle (arity 2 < 4). Leaf: syscall clobbers rcx/r11 (both SysV caller-save, harmless). Effect/capability set matches syscall_shim.pdx sys_cap_invoke exactly: !{sysreg} @{cap} -- the kernel-side transitive widening ({mem,sysreg,PortIo} @{cap,paideia.port_io} for the PRESENT path in particular) belongs to cap_handler_tui_canvas.pdx, not this userspace wrapper. Kernel body reachable through this call: cap_handler_tui_canvas.pdx tuih_op_present -> tui_present_body (paideia-os R89.M1-003).",
      block: {
        mov rsi, 0;
        mov rax, 4;
        syscall;
        ret
      }
    }

  // tcc_query_rows(canvas_cap) -> u64
  //
  // TUI_OP_QUERY_ROWS = 1. Rights: R_TUI_INVOKE (0x008). Returns rows
  // the canvas was minted with (kind_tui_canvas.pdx row+32[63:32]).
  pub let tcc_query_rows : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui.M1-004 (postui#4): TUI_OP_QUERY_ROWS (1) wrapper. SysV rdi=canvas_cap passes through as SYSCALL rdi=slot; rsi=1; rax=4. No shuffle (arity 2 < 4). Kernel returns the rows field decoded from the canvas row's packed rowcols word (cap_handler_tui_canvas.pdx tuih_op_qrows: shr rax,32). Leaf.",
      block: {
        mov rsi, 1;
        mov rax, 4;
        syscall;
        ret
      }
    }

  // tcc_query_cols(canvas_cap) -> u64
  //
  // TUI_OP_QUERY_COLS = 2. Rights: R_TUI_INVOKE. Returns cols
  // (kind_tui_canvas.pdx row+32[31:0]).
  pub let tcc_query_cols : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui.M1-004 (postui#4): TUI_OP_QUERY_COLS (2) wrapper. SysV rdi=canvas_cap passes through; rsi=2; rax=4. Kernel masks the packed rowcols word by 0xFFFFFFFF (cap_handler_tui_canvas.pdx tuih_op_qcols). Leaf.",
      block: {
        mov rsi, 2;
        mov rax, 4;
        syscall;
        ret
      }
    }

  // tcc_query_id(canvas_cap) -> u64
  //
  // TUI_OP_QUERY_ID = 3. Rights: R_TUI_INVOKE. Returns canvas_id, the
  // kernel-assigned monotonic id from tui_next_canvas_id (never 0 for a
  // successfully minted canvas; see kind_tui_canvas.pdx row+8).
  pub let tcc_query_id : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui.M1-004 (postui#4): TUI_OP_QUERY_ID (3) wrapper. SysV rdi=canvas_cap passes through; rsi=3; rax=4. Kernel returns the row's canvas_id word directly (cap_handler_tui_canvas.pdx tuih_op_qid). Leaf.",
      block: {
        mov rsi, 3;
        mov rax, 4;
        syscall;
        ret
      }
    }

  // tcc_query_tty_id(canvas_cap) -> u64
  //
  // TUI_OP_QUERY_TTY_ID = 4. Rights: R_TUI_INVOKE. Returns the bound
  // TTY's row_id via kind_tty.pdx tty_row_id (cap_handler_tui_canvas.pdx
  // tuih_op_qttyid reads the row's tty_slot and forwards).
  pub let tcc_query_tty_id : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui.M1-004 (postui#4): TUI_OP_QUERY_TTY_ID (4) wrapper. SysV rdi=canvas_cap passes through; rsi=4; rax=4. Kernel forwards the row's tty_slot into kind_tty.pdx tty_row_id and returns that (cap_handler_tui_canvas.pdx tuih_op_qttyid). Leaf.",
      block: {
        mov rsi, 4;
        mov rax, 4;
        syscall;
        ret
      }
    }

  // ==========================================================================
  // FROZEN 2-ARG sys_cap_invoke ABI -- postui#41 fix.
  //
  // The kernel-side dispatcher for sys_cap_invoke (SC+ ID 4) is
  // FROZEN at TWO arguments after the syscall entry: (slot, op_arg).
  // See design/user/syscall-table.md row 4 and
  // src/kernel/core/syscall/dispatch.pdx dispatch_cap_invoke
  // (lines 1166-1170):
  //
  //     dispatch_cap_invoke:
  //       mov rdi, rsi;      // slot   <- SYSCALL arg1
  //       mov rsi, rdx;      // op_arg <- SYSCALL arg2
  //       call cap_invoke;
  //       ret;
  //
  // Extra SYSCALL args (rdx/r10/r8/r9) are NEVER read by the
  // dispatcher and are SILENTLY DROPPED before cap_invoke is called.
  // The prior "wire-compatible" claim on tcc_resize/tcc_clear/
  // tcc_debug_print (M1-004 landing) was FALSE: their in-register
  // shuffle placed rows/cols/cell/msg into slots the kernel does not
  // read. The kernel-side R89.M1-002 stubs for these ops return 0
  // without consulting those registers, so the falsehood was not a
  // live bug (nothing broke because nothing was expected to work),
  // but it made the wrappers dishonest and blocked any client-side
  // reasoning about what actually reaches the kernel.
  //
  // ADR (postui#41): the three previously-arity-3 wrappers below are
  // reduced to arity-1 (canvas_cap only), matching the frozen ABI
  // exactly. Every wrapper below now emits the identical shape as
  // tcc_present -- 4 instructions total, no register shuffle:
  //
  //     mov rsi, <op>;
  //     mov rax, 4;
  //     syscall;
  //     ret;
  //
  // Payload delivery for RESIZE (rows/cols), CLEAR (16-byte cell),
  // and DEBUG_PRINT (msg_ptr/msg_len) is DEFERRED to a future landing
  // that mints a per-canvas KIND_MEMORY scratch region at cap-mint
  // time (option (b) in the postui#41 issue body). The scratch region
  // becomes the side-channel: the client writes its payload there
  // before invoking a nullary trigger op, and the kernel-side handler
  // reads it back via the row's memory_slot. That is the same pattern
  // KIND_TUI_CANVAS already uses for its back/front cell buffers
  // (canvas_present.pdx tui_present_body reads the row's memory_slot
  // rather than any syscall arg), so extending it to RESIZE/CLEAR/
  // DEBUG_PRINT payloads is architecturally continuous. Cross-repo
  // work: KIND_TUI_CANVAS mint must reserve a scratch prefix in the
  // memory region (see design/kernel/kind-tui-canvas.md §Ops rows
  // 5/6/7 for the payload layout to freeze). Until that lands,
  // tcc_resize/clear/debug_print invoke rights-checked kernel stubs
  // that return 0 -- semantically no-ops -- and the arity-1 shape
  // makes that honest.
  //
  // The alternate option (a) -- bit-packing rows+cols into op_arg
  // for RESIZE -- was rejected because it would fix only RESIZE (a
  // 16-byte cell and a ptr+len pair both exceed u64), and adopting
  // heterogeneous encodings across the eight-op table (five nullary,
  // one packed, two side-channel) is less legible than one uniform
  // side-channel policy applied to every arity-3 op.
  //
  // Option (c) -- widen sys_cap_invoke to arity 4+ -- was rejected
  // because it breaks the freeze on the SC+ ID 4 dispatcher and
  // ripples through every KIND_* handler that has already been
  // written against the (rights, target_ptr, op_arg) shape (see
  // kind_tty.pdx cap_handler_tty and every existing cap_handler_*).
  // ==========================================================================

  // tcc_resize(canvas_cap) -> u64
  //
  // TUI_OP_RESIZE = 5. Rights: R_TUI_RESIZE (0x010). Signals a
  // terminal resize event to the kernel; the real body re-derives
  // rows/cols and re-maps the backing region (a fresh mint under the
  // hood, old row revoked -- see design/kernel/kind-tui-canvas.md
  // §Ops row 5).
  //
  // ARITY-1 per postui#41 (see FROZEN 2-ARG ABI block above): the
  // frozen sys_cap_invoke dispatcher does not forward rdx/r10/r8, so
  // rows and cols cannot be passed as syscall args. Payload delivery
  // (the new rows/cols the client observed) is DEFERRED to the
  // KIND_MEMORY scratch-region landing; today's kernel-side R89.M1-
  // 002 body (cap_handler_tui_canvas.pdx tuih_op_resize lines 154-
  // 160) is a rights-checked stub returning 0, so an arity-1 nullary
  // trigger is semantically complete for the current tip.
  pub let tcc_resize : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui#41 fix: TUI_OP_RESIZE (5) wrapper is now arity-1 (canvas_cap only). The frozen sys_cap_invoke ABI (SC+ ID 4) accepts exactly (slot, op_arg) -- dispatch_cap_invoke (src/kernel/core/syscall/dispatch.pdx:1166-1170) forwards only rdi=slot and rsi=op_arg into cap_invoke; any additional SYSCALL args (rdx/r10/r8/r9) are silently dropped. The prior 3-arg tcc_resize's register shuffle (mov r10, rdx; mov rdx, rsi; mov rsi, 5) placed rows/cols into slots the kernel never reads, giving the wrapper a false 'wire-compatible' claim. The arity-1 shape below matches tcc_present exactly: SysV rdi=canvas_cap passes through as SYSCALL rdi=slot; rsi is loaded with the op ordinal 5 (TCC_OP_RESIZE); rax is loaded with SC+ ID 4 (TCC_SYS_CAP_INVOKE). No shuffle. Leaf: syscall clobbers rcx/r11 (both SysV caller-save, harmless). Effect/capability set matches syscall_shim.pdx sys_cap_invoke exactly: !{sysreg} @{cap}. Payload delivery (the new rows/cols) is DEFERRED to a follow-up landing that mints a per-canvas KIND_MEMORY scratch region at cap-mint time; the client will write its payload there before invoking this nullary trigger, and cap_handler_tui_canvas's real body (R89.M1-004 canvas_damage.pdx) will read it via the row's memory_slot. Until then this wrapper returns whatever tuih_op_resize returns -- 0 today (rights-checked stub). No `test`; no `and reg,imm64`; no 2-op imul; no r11 touched.",
      block: {
        mov rsi, 5;
        mov rax, 4;
        syscall;
        ret
      }
    }

  // tcc_clear(canvas_cap) -> u64
  //
  // TUI_OP_CLEAR = 6. Rights: R_TUI_RESIZE (shared with RESIZE per
  // design/kernel/kind-tui-canvas.md §Rights -- both are backing-store
  // mutators). The real body fills back and front regions with a
  // caller-supplied 16-byte Cell.
  //
  // ARITY-1 per postui#41 (see FROZEN 2-ARG ABI block above): the
  // 16-byte cell (two u64 words in the cell.pdx wire format --
  // symbol|fg.rgb|bg.r plus bg.gb|mods|reserved) cannot fit in the
  // single u64 op_arg slot the frozen ABI provides, so the cell
  // payload MUST come through the KIND_MEMORY scratch-region side-
  // channel. Client will write the cell wire bytes to the scratch
  // prefix before invoking this nullary trigger; kernel-side real
  // body (R89.M1-004 canvas_damage.pdx) will read those bytes via
  // the row's memory_slot. Today's kernel stub (cap_handler_tui_
  // canvas.pdx tuih_op_clear lines 162-168) is rights-checked and
  // returns 0 without touching either region, so an arity-1 wrapper
  // is a semantically complete no-op for the current tip.
  pub let tcc_clear : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui#41 fix: TUI_OP_CLEAR (6) wrapper is now arity-1 (canvas_cap only). Same rationale as tcc_resize: the frozen sys_cap_invoke ABI drops any SYSCALL args past rsi (op_arg), so the 16-byte Cell (cell_hi word0 + cell_lo word1 of the cell.pdx wire format) cannot travel in rdx/r10 as the prior 3-arg wrapper pretended. Bit-packing is not viable here either -- a Cell is 128 bits, exceeding u64 op_arg. Payload delivery for the cell wire form is DEFERRED to the KIND_MEMORY scratch-region landing (see class comment above); client will write 16 bytes to the scratch prefix, invoke this nullary trigger, kernel-side real body (canvas_damage.pdx, R89.M1-004) reads via memory_slot. Body identical shape to tcc_present/tcc_resize: SysV rdi=canvas_cap passes as SYSCALL rdi=slot; rsi=6 (TCC_OP_CLEAR); rax=4 (TCC_SYS_CAP_INVOKE); syscall; ret. Leaf, no shuffle, no r11 touched, no forbidden mnemonics.",
      block: {
        mov rsi, 6;
        mov rax, 4;
        syscall;
        ret
      }
    }

  // tcc_debug_print(canvas_cap) -> u64
  //
  // TUI_OP_DEBUG_PRINT = 7. Rights: R_TUI_OBSERVE (0x400). Debug hook
  // that mirrors TTY_OP_DEBUG_PRINT -- the kernel handler emits a
  // klog line keyed on the canvas row_id (no user-observable side
  // effect beyond that emission).
  //
  // ARITY-1 per postui#41 (see FROZEN 2-ARG ABI block above): the
  // (msg_ptr, msg_len) pair is 16 bytes -- exceeds op_arg's u64 --
  // and the frozen ABI cannot deliver it via extra SYSCALL args. The
  // kernel R89.M1-002 body (cap_handler_tui_canvas.pdx tuih_op_dbg
  // lines 170-182) emits klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_,
  // tuih_dbg_msg, tuih_k_slot, row_id) using a fixed message string
  // -- msg_ptr/msg_len were never consulted at any prior landing, so
  // reducing the wrapper to arity-1 is behavior-preserving for the
  // current kernel. Payload delivery for a caller-supplied message
  // is DEFERRED to the KIND_MEMORY scratch-region landing (see class
  // comment above); client will write the message bytes plus a
  // length prefix to the scratch prefix, invoke this nullary
  // trigger, and a future canvas_damage.pdx body will echo those
  // bytes into the klog record instead of the fixed tuih_dbg_msg.
  pub let tcc_debug_print : (u64) -> u64 !{sysreg} @{cap} =
    fn (canvas_cap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "postui#41 fix: TUI_OP_DEBUG_PRINT (7) wrapper is now arity-1 (canvas_cap only). Same rationale as tcc_resize/tcc_clear: the frozen sys_cap_invoke ABI drops SYSCALL args past rsi (op_arg), so msg_ptr/msg_len cannot travel in rdx/r10 as the prior 3-arg wrapper pretended. The kernel R89.M1-002 body (tuih_op_dbg) already emits a fixed klog message keyed only on row_id -- msg_ptr/msg_len were never consulted at that landing, so reducing arity is behavior-preserving. Payload delivery for a caller-supplied message string is DEFERRED to the KIND_MEMORY scratch-region landing (see class comment above); the client will write the message bytes plus a length prefix to the scratch prefix and invoke this nullary trigger, and a future kernel body will echo those bytes into the klog record. Body identical shape to tcc_present/tcc_resize/tcc_clear: SysV rdi=canvas_cap passes as SYSCALL rdi=slot; rsi=7 (TCC_OP_DEBUG_PRINT); rax=4 (TCC_SYS_CAP_INVOKE); syscall; ret. Leaf, no shuffle, no r11 touched, no forbidden mnemonics.",
      block: {
        mov rsi, 7;
        mov rax, 4;
        syscall;
        ret
      }
    }

}
