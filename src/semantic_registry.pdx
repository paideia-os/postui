// src/semantic_registry.pdx -- postui.M2-009 (paideia-os/postui#18)
//
// SemanticRegistry: per-widget schema-hash constants + libpdx-semantic-
// pipe Send/Binding glue.
//
// =============================================================================
// SCOPE (docs/design.md §2.3 Semantic-pipe integration, §5.1 M2-009)
// =============================================================================
//
// Every widget in the M2 catalog exports a `<w>_view_pack` function that
// lays a fixed-schema semantic-pipe record into caller-provided memory.
// The packers exist since M1-006 (block_view_pack) / M2-004..M2-008
// (paragraph/list/table/tabs/scrollbar); this module ships the LAST
// hop -- the schema-hash constant table + the Send/Binding primitives
// that route packed records to a subscriber's callback.
//
// This landing is deliberately the SMALLEST thing that satisfies the
// M2-009 contract of docs/design.md §2.3 without pretending
// libpdx-semantic-pipe already exists in userspace. Concretely:
//
//   - SEMANTIC_SCHEMA_<TAG> : u64 constants, one per widget-view
//     schema. At v1 the "hash" IS the widget's four-byte MAGIC from
//     the view record's header (BLKV, PGVW, LSVW, TBVW, TABV, SBVW).
//     A real content-addressable BLAKE3 hash over each widget's frozen
//     schema-name+field-layout string is deferred to postui.M2-010's
//     boot smoke or a later hardening pass -- swapping the constant
//     values here does NOT change any call site (call sites reference
//     the SEMANTIC_SCHEMA_<TAG> symbol, not the literal).
//
//   - semantic_send(schema, record_ptr, record_len) -> u64: LIVE.
//     Issues sys_semantic_send at sysno 115 (paideia-os#2350, commit
//     71a15fb landed the kernel path in R90-XREPO; postui#42 flipped
//     this body from the M2-009 stub). The three SysV arg registers
//     (rdi=schema, rsi=record_ptr, rdx=record_len) map identically
//     to the first three SYSCALL arg registers, so no register
//     shuffle is needed -- the body is literally `mov rax, 115;
//     syscall; ret`. Returns whatever the syscall returns (0 on
//     success; per-syscall error sentinels otherwise).
//
//   - semantic_binding_init(binding_slot, schema, callback) -> u64:
//     writes a 24-byte Binding record into caller-provided memory. This
//     is the shape a downstream subscriber holds in its static
//     subscription table so semantic_binding_dispatch can walk it.
//
//   - semantic_binding_dispatch(binding_ptr, incoming_schema,
//     record_ptr, record_len) -> u64: schema-match test; on hit,
//     tail-calls the callback with (record_ptr, record_len); on miss,
//     returns 0. Enables consumer-side subscription via a static
//     dispatch table walk, no allocator, no runtime registry lookup.
//
// =============================================================================
// BINDING WIRE (24 bytes, SEM_BINDING_BYTES)
// =============================================================================
//
//   [+0..+8)   schema      u64 (SEMANTIC_SCHEMA_<TAG> the binding filters on)
//   [+8..+16)  callback    u64 (SysV function pointer:
//                              fn (record_ptr: u64, record_len: u64) -> u64)
//   [+16..+24) _reserved   u64 (zero on init; RESERVED for a future
//                              "next-in-chain" slot when M2-010's boot
//                              smoke wires a static linked-list of
//                              bindings per fd -- kept at 24 B so that
//                              landing is a wire-preserving field
//                              rename, not a layout bump)
//
// 24 bytes is 3 u64 slots, natural 8-byte alignment throughout, and
// avoids the 16-B pad a 32-B "next-slot-reserved" layout would carry
// for no marginal benefit at v1. Every field is a u64 so no byte-load
// dance is needed to read them back -- dispatch is 2 qword loads.
//
// =============================================================================
// ERROR-BAND POLICY (issue #18 option (b))
// =============================================================================
//
// This module ships NO error sentinels. The M2 error band 0xFFFFEBC0..
// 0xFFFFEBCF is already fully allocated across Layout / Text / Scrollbar
// (see src/layout.pdx / src/text.pdx / src/widgets/scrollbar.pdx); the
// Lib POSTUI_ERR_BAND anchor 0xFFFFEB80..0xFFFFEB8F is reserved for the
// wave-scoped identity slot and would collide with a future Lib
// expansion. Per issue #18 acceptance list, the semantic-pipe primitives
// return the u64 status their underlying operation produces:
//
//   - semantic_send returns whatever sys_semantic_send returns (0 on
//     success; per-syscall error sentinels otherwise).
//   - semantic_binding_init returns 0 on success. It cannot fail -- the
//     three fields all write unconditionally to caller-provided memory
//     and no runtime state is consulted. A future revision that
//     rejects a null binding_slot could return a POSTUI_ERR_BAND-anchored
//     sentinel once the band's overflow-page allocation lands.
//   - semantic_binding_dispatch passes through the callback's own return
//     value on a schema hit, or returns 0 on a schema miss. A caller
//     that needs to distinguish "no subscriber" from "subscriber
//     returned 0" walks its own static table and inspects the miss
//     directly rather than asking dispatch to invent a discriminator.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`SemanticRegistry`), matches
//     file basename `semantic_registry.pdx` (snake_case -> PascalCase
//     via the paideia-as module-registry rule the M1-001 scaffold's
//     compliance list pinned).
//   - No `test` mnemonic; every zero-check is `cmp reg, 0`.
//   - Every schema-hash constant (0x56424154 max) fits imm32 signed
//     positive (< 0x7FFFFFFF = 2_147_483_647); a load site emits the
//     compact 5-byte `mov r32, imm32` form, not the 10-byte movabs.
//     Matches the SBVW magic load in scrollbar_view_pack line 687.
//   - No 2-op `imul reg, imm` (none needed; no address arithmetic).
//   - No `and reg, imm64` (no masks in this module).
//   - Reserved-label prefix `sr_` throughout (sr_bd_ for
//     semantic_binding_dispatch's miss/hit arms).
//   - Effect row `!{mem}` on every function that touches memory
//     (semantic_binding_init writes 3 qwords through rdi;
//     semantic_binding_dispatch reads 2 qwords through rdi).
//     semantic_send declares `!{sysreg}` -- the syscall entry is
//     its only side effect; no callee-side memory access.
//   - semantic_binding_dispatch's `call rax` invokes the caller's
//     callback function pointer. Entry rsp%16 == 8 (SysV requires
//     (rsp+8) % 16 == 0 at function entry); a `call` instruction
//     itself requires rsp%16 == 0 immediately before it executes, so
//     dispatch brackets the nested call with `sub rsp, 8` / `add rsp,
//     8` -- the same idiom widget_kind.pdx's widget_draw uses around
//     its `call block_draw` (entry rsp%16==8 -> 0 -> restored to 8
//     before our own `ret`). The callback's own effect set is the
//     caller's responsibility (dispatch is effect-transparent -- same
//     posture the shell's own completion.pdx dispatch primitives
//     take).
//   - No callee-save touched in ANY body; every function is a leaf or
//     a tail-call. rsp is unchanged across every entry point except
//     the transient sub/add rsp,8 bracket around `call rax` in
//     dispatch (restored before its `ret`).

module SemanticRegistry = structure {

  // ==========================================================================
  // Schema-hash constants (docs/design.md §2.3)
  //
  // Six u64 constants, one per widget-view schema shipping in postui M1..M2.
  // At v1 the "hash" is the widget's four-byte little-endian MAGIC
  // packed as a u32-in-u64 -- exactly the byte sequence a subscriber
  // reads from the record header at [+0..+4). This makes the schema-
  // hash equal to a full-record-header read on the subscriber side,
  // so bind_by_hash and read-magic-and-compare are identical operations.
  //
  // The full BLAKE3-over-schema-name hash contract docs/design.md §2.3
  // describes lands with libpdx-semantic-pipe's registry glue. Swapping
  // the values here (e.g. replacing the MAGIC with the first 8 bytes
  // of BLAKE3("BlockView@0.1")) is a WIRE-COMPATIBLE change for every
  // consumer that references the SEMANTIC_SCHEMA_<TAG> symbol rather
  // than the literal -- the symbol is the compile-time authority, the
  // value is a v1 placeholder documented as such.
  //
  // Each MAGIC fits imm32 signed positive (< 0x7FFFFFFF = 2_147_483_647)
  // so a load-site `mov rax, imm` emits the compact 5-byte
  // `mov r32, imm32` form, not the 10-byte movabs.
  //
  //   BLKV = 'V' 'K' 'L' 'B' little-endian     = 0x564B4C42
  //   PGVW = 'W' 'V' 'G' 'P'                   = 0x57564750
  //   LSVW = 'W' 'V' 'S' 'L'                   = 0x5756534C
  //   TBVW = 'W' 'V' 'B' 'T'                   = 0x57564254
  //   TABV = 'V' 'B' 'A' 'T'                   = 0x56424154
  //   SBVW = 'W' 'V' 'B' 'S'                   = 0x57564253
  //
  // Cross-referenced to the packer that emits each header:
  //   BLKV -> src/block.pdx block_view_pack, BLKV_MAGIC L205.
  //   PGVW -> src/widgets/paragraph.pdx paragraph_view_pack.
  //   LSVW -> src/widgets/list.pdx list_view_pack.
  //   TBVW -> src/widgets/table.pdx table_view_pack.
  //   TABV -> src/widgets/tabs.pdx tabs_view_pack.
  //   SBVW -> src/widgets/scrollbar.pdx scrollbar_view_pack L680.
  // ==========================================================================
  pub let SEMANTIC_SCHEMA_BLKV : u64 = 0x564B4C42
  pub let SEMANTIC_SCHEMA_PGVW : u64 = 0x57564750
  pub let SEMANTIC_SCHEMA_LSVW : u64 = 0x5756534C
  pub let SEMANTIC_SCHEMA_TBVW : u64 = 0x57564254
  pub let SEMANTIC_SCHEMA_TABV : u64 = 0x56424154
  pub let SEMANTIC_SCHEMA_SBVW : u64 = 0x57564253

  // ==========================================================================
  // Binding wire layout (24 bytes)
  //
  // Offset constants are named so a downstream subscriber can pattern-
  // match against them rather than tracking magic 0/8/16 literals.
  // Matches the BLOCK_OFF_* / TABS_OFF_* / SBVW_OFF_* discipline every
  // other postui module already establishes.
  // ==========================================================================
  pub let SEM_BINDING_BYTES     : u64 = 24
  pub let SEM_BINDING_OFF_SCHEMA   : u64 = 0
  pub let SEM_BINDING_OFF_CALLBACK : u64 = 8
  pub let SEM_BINDING_OFF_RESERVED : u64 = 16

  // ==========================================================================
  // Stub-vs-real-body marker for semantic_send.
  //
  // Set to 1 as of postui#42 -- sys_semantic_send landed at sysno 115
  // (paideia-os#2350, commit 71a15fb), and this module's semantic_send
  // now issues the syscall directly. Kept as a public constant so a
  // caller can key its telemetry off "sent" vs "stubbed" without
  // introspecting the syscall path. The 0 -> 1 flip was a WIRE-
  // PRESERVING change: semantic_send's signature is unchanged; the
  // body gained `mov rax, 115; syscall` in place of `xor rax, rax`,
  // and the effect row widened from !{} to !{sysreg}.
  // ==========================================================================
  pub let SEMANTIC_SEND_LIVE : u64 = 1

  // ==========================================================================
  // semantic_send(schema, record_ptr, record_len) -> u64
  //
  // LIVE. Issues sys_semantic_send at sysno 115 (paideia-os#2350,
  // commit 71a15fb). Body:
  //
  //     mov rax, 115;
  //     syscall;
  //     ret
  //
  // The three SysV arg regs (rdi=schema, rsi=record_ptr, rdx=record_len)
  // map identically to the first three SYSCALL arg regs (rdi/rsi/rdx),
  // so NO register shuffle is needed -- the body is a bare sysno-load
  // plus syscall. Contrast tcc_resize (src/tui_canvas_client.pdx L260..
  // 272) which does need a shuffle because its SysV arity exceeds 3
  // and SYSCALL uses r10 in place of SysV's rcx for arg4.
  //
  // Register plan: rdi=schema (passed through), rsi=record_ptr (passed
  // through), rdx=record_len (passed through), rax=sysno on entry to
  // syscall / return value after. Pure leaf: no callee-save touched,
  // no push/pop, no memory access on our side (the syscall path itself
  // reads the caller's record buffer -- that side effect is captured
  // by !{sysreg}, not by our own !{mem}). Effect `!{sysreg}` reflects
  // the syscall entry.
  //
  // Sysno 115 fits imm8 (< 128), so `mov rax, 115` emits the compact
  // 5-byte `mov r32, imm32` form (imm8 is not a distinct mov encoding
  // in x86_64; the assembler picks the shortest imm-fitting form and
  // 115 is safely inside imm32-signed-positive).
  // ==========================================================================
  pub let semantic_send : (u64, u64, u64) -> u64 !{sysreg} @{} =
    fn (schema: u64) (record_ptr: u64) (record_len: u64) -> unsafe {
      effects: {sysreg},
      capabilities: {},
      justification: "postui.M2-009 flipped by postui#42: semantic_send is LIVE and issues sys_semantic_send at sysno 115 (paideia-os#2350, commit 71a15fb landed the kernel path in R90-XREPO). Body: `mov rax, 115; syscall; ret`. The three SysV arg registers (rdi=schema, rsi=record_ptr, rdx=record_len) map identically to the first three SYSCALL arg registers so no register shuffle is needed (unlike tcc_resize's 4-arg case at src/tui_canvas_client.pdx L260-272 where SYSCALL's r10 replaces SysV's rcx for arg4). Sysno 115 fits imm32-signed-positive (< 0x7FFFFFFF), so `mov rax, 115` emits the compact 5-byte `mov r32, imm32` form (not the 10-byte movabs). Return value = whatever sys_semantic_send returns; rax already carries it after the syscall completes. Pure leaf: no callee-save touched, no push/pop, no memory access on our side (the syscall path reads the caller's record buffer, captured by !{sysreg} at this boundary rather than !{mem} which would advertise a store the syscall entry itself does not do). Effect widened from the M2-009 stub's !{} to !{sysreg} in the same edit that added the syscall instruction. No `test` mnemonic; no `and`; no `imul`; no `cmp reg, imm64`. Reserved-label prefix sr_ per docs fingerprint discipline (none needed here -- straight-line body, no jumps).",
      block: {
        mov rax, 115;
        syscall;
        ret;
      }
    }

  // ==========================================================================
  // semantic_binding_init(binding_slot, schema, callback) -> u64
  //
  // Write a 24-byte Binding record into [rdi..rdi+24):
  //   [+0]  = schema     (rsi)
  //   [+8]  = callback   (rdx)
  //   [+16] = 0          (reserved; future next-slot pointer)
  //
  // Returns 0 (OK) unconditionally. A null binding_slot (rdi == 0)
  // would fault the first store; callers are expected to provide a
  // writable 24-byte slot -- the same posture every postui packer takes
  // (block_view_pack, scrollbar_view_pack). A future revision that
  // returns a POSTUI_ERR_BAND-anchored sentinel on rdi == 0 is a
  // signature-preserving change (the u64 return already exists).
  //
  // Register plan: rdi=binding_slot (write-only until return), rsi=schema
  // (read once), rdx=callback (read once), rax=return + zeroing scratch.
  // Pure leaf: no callee-save touched, no push/pop, no nested call.
  // Effect `!{mem}` (3 qword-stores through rdi).
  // Labels prefixed sr_ per docs fingerprint discipline (none needed
  // here -- straight-line body).
  // ==========================================================================
  pub let semantic_binding_init : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (binding_slot: u64) (schema: u64) (callback: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "postui.M2-009 (postui#18): semantic_binding_init writes 24 bytes of Binding into [rdi..rdi+24) then returns 0. Three qword stores in straight-line order: [rdi+0] = rsi (schema), [rdi+8] = rdx (callback), [rdi+16] = 0 (reserved; written via xor rax, rax; mov [rdi+16], rax so a caller re-initing over dirty memory does not leave a stale next-slot pointer in the reserved slot -- matches the reserved-byte zeroing block_spec_init does at [rdi+13..16), src/block.pdx L308-312). Return value 0 = OK; xor rax, rax already sits in rax at ret. Every offset (0, 8, 16) fits imm32. No `test`, no `imul`, no `and`, no `cmp`. Pure leaf: no callee-save touched, no push/pop, no nested call. Effect `!{mem}` -- 3 qword-stores through rdi. Reserved-label prefix sr_ per docs fingerprint discipline (none needed here -- straight-line body, no jumps).",
      block: {
        mov [rdi + 0], rsi;
        mov [rdi + 8], rdx;
        xor rax, rax;
        mov [rdi + 16], rax;
        ret;
      }
    }

  // ==========================================================================
  // semantic_binding_dispatch(binding_ptr, incoming_schema, record_ptr,
  //                            record_len) -> u64
  //
  // If the binding's stored schema (at [rdi+0]) matches incoming_schema
  // (rsi) AND the callback (at [rdi+8]) is non-null, invoke:
  //     callback(record_ptr, record_len)
  // as a tail-call and return whatever the callback returned. On a
  // schema miss or a null callback, return 0.
  //
  // Consumer-side dispatch pattern: a subscriber holds an array of
  // Binding records in .rodata (or in a static allocator slot). Its
  // on-receive handler walks the array once per incoming frame:
  //
  //     for i in 0..NBINDINGS {
  //       let r = semantic_binding_dispatch(
  //           bindings[i], frame.schema, frame.data, frame.len);
  //       // r == 0 iff this binding did not fire; a real callback
  //       // that returns 0 is indistinguishable, which is fine
  //       // because the walk fires every matching binding regardless
  //       // of return value.
  //     }
  //
  // The tail-call idiom (`call rax` then `ret`, with no local frame or
  // stack shuffle) preserves the caller's stack layout end-to-end so
  // this function is effectively a jump table entry -- the callee's
  // return address is the caller's, not this dispatcher's.
  //
  // Register plan: rdi=binding_ptr, rsi=incoming_schema, rdx=record_ptr,
  // rcx=record_len, rax=stored_schema then callback then return. Two
  // qword loads through rdi ([rdi+0], [rdi+8]) then a 2-mov arg shuffle
  // (rdi <- rdx, rsi <- rcx) then `call rax`. Entry rsp%16 == 8 (SysV);
  // a `call` requires rsp%16 == 0 immediately before it executes, so
  // `sub rsp, 8` brings entry-time 8 down to 0 for the nested call,
  // and `add rsp, 8` restores it afterward so our own `ret` pops the
  // correct return address (same bracket widget_kind.pdx's widget_draw
  // uses around `call block_draw`). No callee-save touched.
  //
  // Effect `!{mem}` covers the two binding-slot loads. The callback's
  // own effect set is the caller's responsibility -- dispatch is
  // effect-transparent (same posture the shell's completion.pdx dispatch
  // primitives take when they route input through a caller-provided
  // handler).
  //
  // Labels prefixed sr_bd_ per docs fingerprint discipline.
  // ==========================================================================
  pub let semantic_binding_dispatch : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (binding_ptr: u64) (incoming_schema: u64) (record_ptr: u64) (record_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "postui.M2-009 (postui#18): semantic_binding_dispatch tail-calls the caller's callback iff the binding's stored schema matches. Phase 1 (schema match): load stored schema from [rdi+0] into rax; cmp rax, rsi; jne sr_bd_miss. Phase 2 (null-callback guard): load callback from [rdi+8] into rax; cmp rax, 0; je sr_bd_miss. Phase 3 (arg shuffle + tail call): mov rdi, rdx (record_ptr into SysV arg1); mov rsi, rcx (record_len into SysV arg2); sub rsp, 8 (SysV requires (rsp+8)%16==0 at function entry, i.e. entry rsp%16==8 here, and requires rsp%16==0 immediately before any `call` executes -- sub rsp,8 brings entry-time 8 down to the required 0 for the nested `call rax`, the same bracket widget_kind.pdx's widget_draw uses around `call block_draw`); call rax; add rsp, 8 (restores rsp to entry-time 8 so our own `ret` pops the correct return address). Callback's return value stays in rax across the add rsp,8; ret returns to our caller with rax passed through verbatim. Phase 4 (miss arm sr_bd_miss): xor rax, rax; ret. The two `cmp reg, 0` are imm32-safe (0 is the smallest imm8). No `test` mnemonic. No `imul`, no `and`, no `cmp reg, imm64`. No callee-save touched -- rdi/rsi/rdx/rcx are all SysV caller-save (already-dead across our return); rax carries the return. Effect `!{mem}` covers the 2 qword loads through rdi; the callback's own effect set is the caller's responsibility (dispatch is effect-transparent -- same posture completion.pdx's dispatch primitives take when routing input through a caller-provided handler). Labels prefixed sr_bd_ per docs fingerprint discipline (sr_bd_miss for the schema-miss / null-callback arm; the tail-call arm is fall-through).",
      block: {
        // ---- Phase 1: schema match ----------------------------------------
        mov rax, [rdi + 0];
        cmp rax, rsi;
        jne sr_bd_miss;

        // ---- Phase 2: null-callback guard ---------------------------------
        mov rax, [rdi + 8];
        cmp rax, 0;
        je sr_bd_miss;

        // ---- Phase 3: arg shuffle + tail call -----------------------------
        mov rdi, rdx;
        mov rsi, rcx;

        // Align rsp for nested call (entry rsp%16==8 -> 0), call, restore.
        sub rsp, 8;
        call rax;
        add rsp, 8;
        ret;

      sr_bd_miss:
        xor rax, rax;
        ret;
      }
    }

}
