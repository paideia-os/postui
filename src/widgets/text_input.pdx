        cmp r9, 0xC0;
        jb  ti_cr_adv1;                   // stray continuation, defensive
        cmp r9, 0xE0;
        jb  ti_cr_adv2;
        cmp r9, 0xF0;
        jb  ti_cr_adv3;
        cmp r9, 0xF8;
        jb  ti_cr_adv4;
