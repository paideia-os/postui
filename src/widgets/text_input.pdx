    fn (spec_ptr: u64) (buf_ptr: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "postui.M4-001 (postui#27): text_input_draw is the widget_draw entry for WK_TEXTINPUT (13). Push rbx/r12/r13/r14/r15 (5 pushes, 40 B; rsp entry %16 == 8, +40 == 48, rsp %16 == 0). sub rsp, 736 (32-slot state area + 24-B span slot + 24-B line slot + 512-B break array; 736 %16 == 0, rsp remains aligned for the nested line_break_positions call). Phase 0 (prologue): cache buf_ptr in rbx, cols in r12, spec_ptr in r13, packed rect in r14 (from [r13+0]). Extract rect fields (bx/by/bw/bh) into stack slots [rsp+560..584) via mov/shr/and 0xFFFF chains; precompute xe = bx+bw and ye = by+bh into [rsp+592..600). Load buffer_ptr / buffer_len / cursor_byte / scroll_col / mode / style_normal / style_cursor from spec into [rsp+608..664). Early exits: bw == 0 or bh == 0 -> jmp ti_dr_done (rax = 0). Load mode from [rsp+640]; if != 1, dispatch to ti_dr_sl_ (SingleLine); else ti_dr_ml_ (MultiLine). SingleLine (ti_dr_sl_): initialize c (rcx) = 0. ti_dr_sl_loop: cmp rcx, bw ([rsp+576]); jae ti_dr_sl_end. Compute abs = scroll_col ([rsp+632]) + c into rax. If abs < buffer_len ([rsp+616]): load byte = buffer[abs] via `xor r15, r15; mov_b r15, [buffer_ptr + rax + 0]`; compute style = (abs == cursor_byte ([rsp+624])) ? style_cursor : style_normal; stamp cell at (bx+c, by) via `mov r11, by ([rsp+568]); imul r11, r12; add r11, bx ([rsp+560]); add r11, rcx; shl r11, 4; add r11, rbx`; mov_d [r11+0], r15 (byte in low byte, upper 3 zero); shl r15_style, 8; shr r15_style, 8 (defensively zero pad byte per cell_set_style discipline); mov [r11+4], r15_style. Else: skip (cell stays as buffer_init zeroed it). add rcx, 1; jmp ti_dr_sl_loop. ti_dr_sl_end: cursor-at-end post-pass -- if cursor_byte == buffer_len AND cursor_byte >= scroll_col AND (cursor_byte - scroll_col) < bw, stamp space (0x20) at (bx + cursor_col, by) with style_cursor. jmp ti_dr_done. MultiLine (ti_dr_ml_): build synthetic Span at [rsp+512..536): mov rax, buffer_ptr; mov [rsp+512], rax; mov rax, buffer_len; mov [rsp+520], rax; xor rax, rax; mov [rsp+528], rax. Build synthetic Line at [rsp+536..560): lea r15, [rsp+512] (WAIT -- no `lea` per module conformance; use mov r15, rsp; add r15, 512 instead); mov [rsp+536], r15; mov rax, 1; mov [rsp+544], rax; xor rax, rax; mov [rsp+552], rax. Wait -- lea is documented not-used; the `lea r15, [rsp+512]` was in the draft but per module header 'No lea in this module', we use mov+add. Compute line_slot addr similarly: mov rdi, rsp; add rdi, 536 (arg1 for line_break_positions). mov rsi, bw (arg2 max_width). mov rdx, rsp (arg3 out_positions_ptr; break array is at rsp+0). mov rcx, 64 (arg4 out_max). call line_break_positions. Return in rax; if rax > 64 (sentinel or over-cap), degrade to break_count = 0; else use rax. Store break_count to [rsp+664]. Initialize seg_idx = 0 [rsp+672], seg_start = 0 [rsp+680], cur_y = by [rsp+696]. Segment loop ti_dr_ml_seg: cmp cur_y >= ye -> jmp ti_dr_ml_end; compute seg_end: if seg_idx < break_count, seg_end = break[seg_idx] via `mov rdi, seg_idx; shl rdi, 3; mov r15, rsp; add r15, rdi; mov rax, [r15+0]`; else seg_end = buffer_len. Store to [rsp+688]. Byte loop ti_dr_ml_byte: byte_off (rax) = seg_start; col (rcx) = 0. ti_dr_ml_bloop: cmp byte_off, seg_end; jae ti_dr_ml_bend. cmp col, bw; jae ti_dr_ml_bend (right-edge trunc). Load byte, compute style (cursor overlay in place same as SingleLine), stamp at (bx+col, cur_y). add byte_off, 1; add col, 1; jmp ti_dr_ml_bloop. ti_dr_ml_bend: mov seg_start = seg_end; add cur_y, 1; add seg_idx, 1. cmp seg_idx <= break_count (i.e. seg_idx < break_count + 1) -> loop ti_dr_ml_seg. ti_dr_ml_end: cursor-at-end post-pass -- if cursor_byte == buffer_len, compute cursor_seg_start: if break_count == 0, cursor_seg_start = 0; else cursor_seg_start = break[break_count - 1]. cursor_row = by + break_count; cursor_col = buffer_len - cursor_seg_start. If cursor_row < ye AND cursor_col < bw, stamp space with style_cursor. jmp ti_dr_done. ti_dr_done: xor rax, rax; add rsp, 736; pop 5 callee-save; ret. Every immediate (0, 1, 8, 16, 24, 32, 40, 48, 56, 64, 512, 520, 528, 536, 544, 552, 560..728, 0xFF, 0xFFFF, 0x20) fits imm32; shift counts (3, 4, 8, 16, 32, 48) fit imm8. No `test`. 2-op imul is only ever reg,reg (imul r11, r12 for the y*cols product, no imul reg,imm). No `and reg, imm64`. No `lea` -- the two synthetic-struct address computes use mov+add instead. One nested call (line_break_positions), rsp aligned before the call. Effect `!{mem}` covers spec + buffer reads, cell writes through buf_ptr + rbx, and the stack scratch reads/writes. Labels prefixed ti_dr_ per docs fingerprint discipline (ti_dr_sl_ / ti_dr_ml_ / ti_dr_done and sub-labels).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 736;

        // ---- Phase 0: cache args --------------------------------------------
        mov r13, rdi;                     // r13 = spec_ptr
        mov rbx, rsi;                     // rbx = buf_ptr
        mov r12, rcx;                     // r12 = cols
        mov r14, [r13 + 0];               // r14 = packed rect

        // ---- Extract rect fields to stack -----------------------------------
        mov rax, r14;
        and rax, 0xFFFF;
        mov [rsp + 560], rax;             // bx

        mov rax, r14;
        shr rax, 16;
        and rax, 0xFFFF;
        mov [rsp + 568], rax;             // by

        mov rax, r14;
        shr rax, 32;
        and rax, 0xFFFF;
        mov [rsp + 576], rax;             // bw

        mov rax, r14;
        shr rax, 48;
        mov [rsp + 584], rax;             // bh

        // xe = bx + bw
        mov rax, [rsp + 560];
        add rax, [rsp + 576];
        mov [rsp + 592], rax;

        // ye = by + bh
        mov rax, [rsp + 568];
        add rax, [rsp + 584];
        mov [rsp + 600], rax;

        // ---- Early exits on zero-sized rect ---------------------------------
        mov rax, [rsp + 576];
        cmp rax, 0;
        je  ti_dr_done;
        mov rax, [rsp + 584];
        cmp rax, 0;
        je  ti_dr_done;

        // ---- Cache spec fields to stack -------------------------------------
        mov rax, [r13 + 8];               // buffer_ptr
        mov [rsp + 608], rax;
        mov rax, [r13 + 24];              // buffer_len
        mov [rsp + 616], rax;
        mov rax, [r13 + 32];              // cursor_byte
        mov [rsp + 624], rax;
        mov rax, [r13 + 40];              // scroll_col
        mov [rsp + 632], rax;
        mov rax, [r13 + 48];              // mode
        mov [rsp + 640], rax;
        mov rax, [r13 + 56];              // style_normal
        mov [rsp + 648], rax;
        mov rax, [r13 + 64];              // style_cursor
        mov [rsp + 656], rax;

        // ---- Dispatch on mode -----------------------------------------------
        mov rax, [rsp + 640];
        cmp rax, 1;
        je  ti_dr_ml_enter;
        // Fall through to SingleLine.

        // =====================================================================
        // SingleLine draw
        // =====================================================================
      ti_dr_sl_enter:
        xor rcx, rcx;                     // c = 0

      ti_dr_sl_loop:
        // cmp c, bw
        mov rax, [rsp + 576];
        cmp rcx, rax;
        jae ti_dr_sl_end;

        // abs = scroll_col + c
        mov rax, [rsp + 632];
        add rax, rcx;

        // If abs >= buffer_len, skip stamping (cell stays as buffer_init).
        mov rdx, [rsp + 616];
        cmp rax, rdx;
        jae ti_dr_sl_next;

        // Load buffer[abs] into r15
        mov rdx, [rsp + 608];             // buffer_ptr
        xor r15, r15;
        mov_b r15, [rdx + rax + 0];

        // Select style: (abs == cursor_byte) ? style_cursor : style_normal
        mov rdi, [rsp + 624];             // cursor_byte
        mov rsi, [rsp + 648];             // default = style_normal
        cmp rax, rdi;
        jne ti_dr_sl_style_ready;
        mov rsi, [rsp + 656];             // style_cursor
      ti_dr_sl_style_ready:

        // Compute dst = buf_ptr + (by*cols + bx + c)*16
        mov r11, [rsp + 568];             // by
        imul r11, r12;                    // by * cols
        add  r11, [rsp + 560];            // + bx
        add  r11, rcx;                    // + c
        shl  r11, 4;                      // * CELL_BYTES
        add  r11, rbx;                    // + buf_ptr

        // Stamp cell: symbol slot (byte in low, upper 3 zero)
        mov_d [r11 + 0], r15;

        // Style word: defensively zero pad byte (shl 8; shr 8), store at +4
        shl rsi, 8;
        shr rsi, 8;
        mov [r11 + 4], rsi;

      ti_dr_sl_next:
        add rcx, 1;
        jmp ti_dr_sl_loop;

      ti_dr_sl_end:
        // Cursor-at-end post-pass: if cursor_byte == buffer_len AND
        // cursor is visible in the SingleLine window, stamp a space with
        // style_cursor at (bx + cursor_col, by).
        mov rax, [rsp + 624];             // cursor_byte
        mov rdx, [rsp + 616];             // buffer_len
        cmp rax, rdx;
        jne ti_dr_done;                   // cursor was in body, already stamped

        // Compute visible cursor column: cursor_byte - scroll_col
        mov rdx, [rsp + 632];             // scroll_col
        cmp rax, rdx;
        jb  ti_dr_done;                   // cursor is left of window -> invisible
        sub rax, rdx;                     // rax = visible column
        mov rdx, [rsp + 576];             // bw
        cmp rax, rdx;
        jae ti_dr_done;                   // cursor past right edge -> invisible

        // Stamp space (0x20) with style_cursor at (bx + rax, by)
        mov rcx, rax;                     // rcx = c
        mov r11, [rsp + 568];             // by
        imul r11, r12;
        add  r11, [rsp + 560];
        add  r11, rcx;
        shl  r11, 4;
        add  r11, rbx;

        mov r15, 0x20;
        mov_d [r11 + 0], r15;
        mov rsi, [rsp + 656];             // style_cursor
        shl rsi, 8;
        shr rsi, 8;
        mov [r11 + 4], rsi;
        jmp ti_dr_done;

        // =====================================================================
        // MultiLine draw
        // =====================================================================
      ti_dr_ml_enter:
        // ---- Build synthetic Span at [rsp+512..536): (ptr, len, style=0)
        mov rax, [rsp + 608];             // buffer_ptr
        mov [rsp + 512], rax;
        mov rax, [rsp + 616];             // buffer_len
        mov [rsp + 520], rax;
        xor rax, rax;
        mov [rsp + 528], rax;             // style = 0

        // ---- Build synthetic Line at [rsp+536..560):
        //   spans_ptr = &span_slot (rsp + 512)
        //   span_count = 1
        //   alignment = 0
        mov r15, rsp;
        add r15, 512;
        mov [rsp + 536], r15;
        mov rax, 1;
        mov [rsp + 544], rax;
        xor rax, rax;
        mov [rsp + 552], rax;

        // ---- Call line_break_positions(line_ptr, bw, rsp, 64) --------------
        mov rdi, rsp;
        add rdi, 536;                     // line_slot address
        mov rsi, [rsp + 576];             // bw = max_width
        mov rdx, rsp;                     // out_positions_ptr = break_array base
        mov rcx, 64;                      // out_max
        call line_break_positions;

        // Degrade if rax > 64 (sentinel or over-cap): treat as break_count = 0.
        cmp rax, 64;
        jbe ti_dr_ml_bp_ok;
        xor rax, rax;
      ti_dr_ml_bp_ok:
        mov [rsp + 664], rax;             // break_count

        // ---- Init seg_idx, seg_start, cur_y --------------------------------
        xor rax, rax;
        mov [rsp + 672], rax;             // seg_idx = 0
        mov [rsp + 680], rax;             // seg_start = 0
        mov rax, [rsp + 568];             // by
        mov [rsp + 696], rax;             // cur_y = by

        // ---- Segment loop --------------------------------------------------
      ti_dr_ml_seg:
        // cur_y >= ye?
        mov rax, [rsp + 696];
        mov rdx, [rsp + 600];
        cmp rax, rdx;
        jae ti_dr_ml_end;

        // Compute seg_end: (seg_idx < break_count) ? break[seg_idx] : buffer_len
        mov rax, [rsp + 672];             // seg_idx
        mov rdx, [rsp + 664];             // break_count
        cmp rax, rdx;
        jae ti_dr_ml_seg_last;

        // seg_end = break_positions[seg_idx]
        mov rdi, rax;
        shl rdi, 3;                       // rdi = seg_idx * 8
        mov r15, rsp;
        add r15, rdi;
        mov rax, [r15 + 0];
        jmp ti_dr_ml_seg_end_ready;

      ti_dr_ml_seg_last:
        mov rax, [rsp + 616];             // buffer_len

      ti_dr_ml_seg_end_ready:
        mov [rsp + 688], rax;             // seg_end

        // ---- Byte loop within segment --------------------------------------
        mov rax, [rsp + 680];             // byte_off = seg_start
        xor rcx, rcx;                     // col = 0

      ti_dr_ml_bloop:
        // byte_off >= seg_end?
        mov rdx, [rsp + 688];
        cmp rax, rdx;
        jae ti_dr_ml_bend;

        // col >= bw? (right-edge truncation)
        mov rdx, [rsp + 576];
        cmp rcx, rdx;
        jae ti_dr_ml_bend;

        // Load byte = buffer[byte_off]
        mov rdx, [rsp + 608];             // buffer_ptr
        xor r15, r15;
        mov_b r15, [rdx + rax + 0];

        // Select style: (byte_off == cursor_byte) ? style_cursor : style_normal
        mov rdi, [rsp + 624];             // cursor_byte
        mov rsi, [rsp + 648];             // default = style_normal
        cmp rax, rdi;
        jne ti_dr_ml_style_ready;
        mov rsi, [rsp + 656];
      ti_dr_ml_style_ready:

        // Compute dst = buf_ptr + (cur_y*cols + bx + col)*16
        mov r11, [rsp + 696];             // cur_y
        imul r11, r12;
        add  r11, [rsp + 560];            // + bx
        add  r11, rcx;                    // + col
        shl  r11, 4;
        add  r11, rbx;

        mov_d [r11 + 0], r15;
        shl rsi, 8;
        shr rsi, 8;
        mov [r11 + 4], rsi;

        // Advance byte_off and col
        add rax, 1;
        add rcx, 1;
        jmp ti_dr_ml_bloop;

      ti_dr_ml_bend:
        // Advance segment: seg_start = seg_end; cur_y++; seg_idx++.
        mov rax, [rsp + 688];             // seg_end
        mov [rsp + 680], rax;             // seg_start = seg_end

        mov rax, [rsp + 696];
        add rax, 1;
        mov [rsp + 696], rax;

        mov rax, [rsp + 672];
        add rax, 1;
        mov [rsp + 672], rax;

        // Total segments = break_count + 1
        mov rdx, [rsp + 664];
        add rdx, 1;
        cmp rax, rdx;
        jb  ti_dr_ml_seg;
        // Fall through.

      ti_dr_ml_end:
        // Cursor-at-end post-pass: if cursor_byte == buffer_len, compute
        // cursor_row / cursor_col and stamp a space with style_cursor.
        mov rax, [rsp + 624];             // cursor_byte
        mov rdx, [rsp + 616];             // buffer_len
        cmp rax, rdx;
        jne ti_dr_done;                   // cursor in body, already stamped

        // Compute cursor_seg_start: (break_count == 0) ? 0 : break[break_count - 1]
        mov rdx, [rsp + 664];             // break_count
        xor r8,  r8;                      // r8 = cursor_seg_start default 0
        cmp rdx, 0;
        je  ti_dr_ml_cs_ready;
        mov rdi, rdx;
        sub rdi, 1;
        shl rdi, 3;
        mov r15, rsp;
        add r15, rdi;
        mov r8, [r15 + 0];
      ti_dr_ml_cs_ready:
        mov [rsp + 720], r8;              // cursor_seg_start

        // cursor_row = by + break_count
        mov r9, [rsp + 568];              // by
        add r9, rdx;                      // + break_count

        // cursor_col = buffer_len - cursor_seg_start
        mov r10, [rsp + 616];             // buffer_len
        sub r10, r8;

        // Visibility checks: cursor_row < ye AND cursor_col < bw
        mov rdi, [rsp + 600];             // ye
        cmp r9, rdi;
        jae ti_dr_done;
        mov rdi, [rsp + 576];             // bw
        cmp r10, rdi;
        jae ti_dr_done;

        // Stamp space with style_cursor at (bx + cursor_col, cursor_row).
        mov r11, r9;                      // cursor_row
        imul r11, r12;
        add  r11, [rsp + 560];            // + bx
        add  r11, r10;                    // + cursor_col
        shl  r11, 4;
        add  r11, rbx;

        mov r15, 0x20;
        mov_d [r11 + 0], r15;
        mov rsi, [rsp + 656];             // style_cursor
        shl rsi, 8;
        shr rsi, 8;
        mov [r11 + 4], rsi;

      ti_dr_done:
        xor rax, rax;
        add rsp, 736;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // text_input_view_pack(spec_ptr, dst) -> u64 (record_len = 40)
  //
  // Pack a TextInputView@0.1 record into [dst..dst+40). Fixed size; no
  // variable-length payload (buffer bytes live behind buffer_ptr and
  // are per-process, not stream-copyable through the semantic pipe --
  // matches ParagraphView / GaugeView / ScrollbarView posture).
  //
  // Field marshalling per the wire block in the module header:
  //   +0   magic       (u32) = TIVW_MAGIC = 0x57564954
  //   +4   record_len  (u32) = 40
  //   +8   rect        (u64) from spec+0  verbatim
  //   +16  cursor_byte (u64) from spec+32 verbatim
  //   +24  buffer_len  (u64) from spec+24 verbatim
  //   +32  mode        (u64) from spec+48 verbatim
  //
  // Register plan: rdi=spec_ptr (read-only), rsi=dst (write-only until
  // return), rax=scratch/return. Pure leaf: no callee-save touched, no
  // push/pop, no nested call. Effect `!{mem}` (reads through rdi;
  // writes through rsi). Labels prefixed ti_vp_ per docs fingerprint
  // discipline (none needed -- straight-line body).
  // ==========================================================================
  pub let text_input_view_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (spec_ptr: u64) (dst: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "postui.M4-001 (postui#27): text_input_view_pack lays a TextInputView@0.1 record at [rsi..rsi+40). Fixed size; NO variable-length payload (buffer bytes are per-process behind buffer_ptr, not stream-copyable). Header phase: `mov rax, 0x57564954` (TIVW_MAGIC, fits imm32 so paideia-as emits the compact 5-byte mov r32, imm32 form, not a 10-byte movabs), mov_d [rsi+0], rax; `mov rax, 40`, mov_d [rsi+4], rax. Payload phase: four verbatim u64 copies from spec fields to view slots: [rdi+0] -> [rsi+8] (rect), [rdi+32] -> [rsi+16] (cursor_byte), [rdi+24] -> [rsi+24] (buffer_len), [rdi+48] -> [rsi+32] (mode). Each copy is `mov rax, [rdi+off]; mov [rsi+off_out], rax`. Return record_len = 40. Every immediate (0, 4, 8, 16, 24, 32, 40, 48, 0x57564954) fits imm32. No `test`, no `imul`, no `and reg, imm64`. Pure leaf: no callee-save touched, no push/pop, no nested call. Effect `!{mem}` (reads through rdi at four offsets; writes through rsi at six offsets). Labels prefixed ti_vp_ per docs fingerprint discipline (none needed -- straight-line body).",
      block: {
        // ---- magic (u32) at [rsi + 0] --------------------------------------
        mov rax, 0x57564954;
        mov_d [rsi + 0], rax;

        // ---- record_len (u32) at [rsi + 4] ---------------------------------
        mov rax, 40;
        mov_d [rsi + 4], rax;

        // ---- rect (u64) at [rsi + 8] verbatim ------------------------------
        mov rax, [rdi + 0];
        mov [rsi + 8], rax;

        // ---- cursor_byte (u64) at [rsi + 16] verbatim ----------------------
        mov rax, [rdi + 32];
        mov [rsi + 16], rax;

        // ---- buffer_len (u64) at [rsi + 24] verbatim -----------------------
        mov rax, [rdi + 24];
        mov [rsi + 24], rax;

        // ---- mode (u64) at [rsi + 32] verbatim -----------------------------
        mov rax, [rdi + 48];
        mov [rsi + 32], rax;

        // ---- Return record_len = 40 ----------------------------------------
        mov rax, 40;
        ret;
      }
    }

}
