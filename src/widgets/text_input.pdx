  // ==========================================================================
  // text_input_draw(spec_ptr, buf_ptr, rows, cols) -> u64
  //
  // Widget_draw-shape entry (postui.M1-007 WidgetKind dispatch keys
  // against this exact shape when routing WK_TEXTINPUT). `rows` is not
