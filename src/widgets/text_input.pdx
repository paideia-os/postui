      block: {
        mov rax, [rdi + 32];              // rax = cursor_byte
        mov rcx, [rdi + 24];              // rcx = buffer_len
        cmp rax, rcx;
        jae ti_cr_ret;                    // at or past end

        mov r8, [rdi + 8];                // r8 = buffer_ptr

        xor r9, r9;
