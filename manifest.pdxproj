# postui — paideia-as build manifest
#
# Wave: postui v1 (Ratatui-parity TUI widget library)
# Milestone: M1 (skeleton + cell buffer + minimal Block widget)
# Doc: docs/design.md §§1–5 (authoritative spec); §5.1 milestone plan.
#
# postui is a userspace LIBRARY (not a tool: no _start, no entry
# frame). It is linked into ring-3 consumers such as postui-top,
# postui-hex, postui-dmesg (docs/design.md §3), plus any future TUI
# app the org ships. paideia-as v0.34+ is the required toolchain
# floor. The M3-001 fixed-point path (src/fixed64.pdx fx_mul /
# fx_scale, widened per postui#43) requires the 1-operand `mul reg64`
# mnemonic introduced in paideia-as v0.33.2 (commit 1bf149b, closes
# paideia-as#1398); the v0.34+ floor above already satisfies this.
# Individual source files are compiled by tools/build.sh into loose
# ELF64 objects under build-out/; downstream packaging steps assemble
# those into consumers' link lines. This manifest is metadata: it
# enumerates the source set, dependencies, and compliance discipline
# for humans and tooling that walk the repo, mirroring the shape
# shell/manifest.pdxproj established in the paideia-os monorepo
# satellites.

name                   = postui
version                = 0.1.0-pre
kind                   = library
caps_decl              = caps.decl
min_paideia_as_version = 0.33.2

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers). Every file
# below is compiled into build-out/<basename>.o by tools/build.sh.
# The M1-001 landing seeds every M1 file so subsequent M1-002..M1-007
# issues only add symbol bodies — the module registry does not
# churn once M1-001 is in.
sources:
  - src/lib.pdx                   # M1-001: library-entry sentinel + version constants
  - src/rect.pdx                  # M1-002: Rect primitive (x/y/rows/cols geometry)
  - src/style.pdx                 # M1-002: Style aggregate (fg/bg/modifier tuple)
  - src/color.pdx                 # M1-002: Color 24-bit truecolor triplet
  - src/cell.pdx                  # M1-003: 16-byte Cell wire-format constants
  - src/buffer.pdx                # M1-003: Buffer back/front region layout
  - src/tui_canvas_client.pdx     # M1-004: KIND_TUI_CANVAS mint/present/query wrappers
  - src/frame.pdx                 # M1-005: Frame/Terminal driver loop
  - src/block.pdx                 # M1-006: Block widget (borders, title, padding)
  - src/widget_kind.pdx           # M1-007: WidgetKind closed enum + widget_draw dispatch
  - src/layout.pdx                # M2-001: Layout engine (integer constraint distribution)
  - src/width.pdx                 # M2-003: Width module (UTF-8 byte scan + EAW table)
  - src/text.pdx                  # M2-002: Text/Span/Line primitives (styled runs, wrap)
  - src/widgets/paragraph.pdx     # M2-004: Paragraph widget + ParagraphView@0.1
  - src/widgets/list.pdx          # M2-005: List + ListState + ListView@0.1
  - src/widgets/table.pdx         # M2-006: Table + TableState + TableView@0.1
  - src/widgets/tabs.pdx          # M2-007: Tabs + TabsView@0.1
  - src/widgets/scrollbar.pdx     # M2-008: Scrollbar + ScrollbarView@0.1
  - src/semantic_registry.pdx     # M2-009: schema-hash constants + Send/Binding glue
  - src/fixed64.pdx               # M3-001: Q32.32 signed fixed-point (paideia-as-native)
  - src/widgets/gauge.pdx         # M3-002: Gauge/LineGauge + GaugeView@0.1
  - src/widgets/sparkline.pdx     # M3-003: Sparkline + SparklineView@0.1
  - src/widgets/barchart.pdx      # M3-004: BarChart + BarChartView@0.1
  - src/widgets/chart.pdx         # M3-005: Chart/axis/dataset + ChartView@0.1
  - src/widgets/canvas.pdx        # M3-006: Canvas (Fixed64/braille) + CanvasView@0.1
  - src/padding.pdx               # M4-004: Padding utility (Rect inset/uniform)
  - src/widgets/text_input.pdx    # M4-001: TextInput/TextArea + TextInputView@0.1
  - src/widgets/tree.pdx          # M4-002: Tree + TreeView@0.1
  - src/widgets/calendar.pdx      # M4-003: Calendar + CalendarView@0.1
  - src/widgets/clear.pdx         # M4-004: Clear widget + ClearView@0.1
  - src/input/event.pdx           # M4-005: Event enum + Key/Resize/Mouse/Paste kinds
  - src/input/esc_parser.pdx      # M4-005: CSI/SS3/OSC ESC-sequence state machine (+M4-006 mouse/paste)
  - src/terminal.pdx              # M4-007: Terminal input dispatcher (KIND_TTY primary vs sys_read fallback)

# --- Library dependencies -----------------------------------------------
# postui's rendering path does not need libpdx-cap or libpdx-argv at
# M1 -- the cap-marshalling wrappers (M1-004) call sys_cap_invoke
# directly through the syscall floor, and there is no argv parsing in
# a library. libpdx-semantic-pipe is a M2/M5 dependency (docs/design.md
# §2.3, §5.1 M2-009) and is intentionally NOT declared here to keep
# M1 free of any transitive-schema-hash rebuild churn.
deps:
  # (empty at M1 by design; M2-009 introduces libpdx-semantic-pipe)

# --- Test targets ------------------------------------------------------
# Populated starting M1-008 (boot smoke: render one Block into a
# canvas fixture and verify cell bytes). Every entry below becomes a
# `paideia-as build --tests` target once the corresponding issue
# lands. tools/build.sh already compiles tests/*.pdx into
# build-out/tests-<basename>.o via its `if [ -d tests ]` loop, so a
# test source landing is picked up without any build.sh change.
#
# Fail-code family bands per design/architecture.md §7:
#   test_boot_smoke                    0xFFFFEDA0..0xFFFFEDAF   (M1-008)
#   test_boot_list_table_smoke         0xFFFFEDB0..0xFFFFEDBF   (M2-010)
#   test_boot_chart_canvas_smoke       0xFFFFEDC0..0xFFFFEDCF   (M3-007)
#   test_boot_widget_catalog_smoke     0xFFFFEDD0..0xFFFFEDDF   (M4-008)
#   test_semantic_version_conformance  0xFFFFEDE0..0xFFFFEDEF   (M5-001)
#   test_widget_catalog_matrix         0xFFFFEDF0..0xFFFFEDFF   (M5-005)
tests:
  - tests/boot_block_smoke.pdx              # M1-008: render one Block, verify cell bytes
  - tests/boot_list_table_smoke.pdx         # M2-010: List+Table render + semantic-pipe round-trip
  - tests/boot_chart_canvas_smoke.pdx       # M3-007: Chart+Canvas deterministic render witness
  - tests/boot_widget_catalog_smoke.pdx     # M4-008: 15-widget render regression corpus
  - tests/semantic_version_conformance.pdx  # M5-001: 4-rule schema-version-tolerance matrix
  - tests/widget_catalog_matrix.pdx         # M5-005: 30-variant full widget-catalog smoke matrix

# --- Documentation targets ---------------------------------------------
# The authoritative postui spec lives at docs/design.md and is not a
# .pdxdoc yet -- it is Markdown for the design phase. postui.M1-009
# (docs/design.md §5.1) files a matching internal design/architecture.md
# analogous to shell's own. `.pdxdoc` surfaces land at M5 packaging
# time alongside the release manifest.
docs:
  - doc/postui.pdxdoc                       # M5-004: .pdxdoc source for the doc viewer

# --- Tool binaries (M5-002+) -------------------------------------------
# postui itself is a library (kind = library above) but the repo also
# ships a small set of tool binaries that demonstrate library use as
# real programs -- each carries its own _start.
tools:
  - tools/scraper_example.pdx               # M5-002: read-only semantic-pipe subscriber example

# --- Paideia-as compliance flags ---------------------------------------
# Same invariant set the shell / libpdx-* satellites observe. A build
# under a non-conforming paideia-as revision refuses fast in tools/
# build.sh's version-floor check.
compliance:
  - module-basename-pascal        # module <BasenamePascalCase>, no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm <= 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call

# --- Release policy (M5-003) -------------------------------------------
# postui M5-003 (docs/design.md §5.1 M5) populates the release manifest
# entries below. Every field mirrors shell.M5-001's release-manifest
# shape (tools/user/shell/design/release-manifest.md §§2-3) and is
# further described in this repo's design/release-manifest.md. The
# `pkg install postui` decoder reads these fields verbatim; a drift
# here is a drift the pkg-side codec observes at install time and the
# release lint refuses fast.
#
# Dual-sign policy: ML-DSA-65 is the primary post-quantum signer;
# Ed25519 rides as a secondary classical signer so clients that pre-
# date the paideia-as v0.33-crypto-kdf toolchain (or that consume the
# tarball out-of-band via a partner mirror) still have a verification
# path. `pkg install postui` requires BOTH signatures to verify; a
# non-Paideia mirror that accepts only classical crypto still gets a
# valid Ed25519 signature to pin. See design/release-manifest.md §3.
release:
  signer_author: snunez+postui-author@paideia-os.dev
  signer_root:   paideia-os-release-root@paideia-os.dev
  mldsa_level:   65
  ed25519:       required
  mirror_target: pkgs.paideia-os
  tarball:       postui-v1.0.0.tar.gz
  manifest_kind: satellite-library
