// tests/widget_catalog_matrix.pdx -- postui.M5-005 (paideia-os/postui#39)
//
// WidgetCatalogMatrix: fifth-wave boot smoke -- exhaustive matrix that
// drives EVERY widget's draw entrypoint through TWO documented state
// variants (30 draw invocations in total) against a shared 80-col x
// 30-row Cell buffer laid out as 10-tile-cols x 3-tile-rows with row
// 9 / row 19 / row 29 guard rows separating tile rows.
//
// =============================================================================
// SCOPE (docs/design.md sec.5.1 M5-005, design/architecture.md sec.7)
// =============================================================================
//
// M5-005 lands the fifth tests/*.pdx module in postui, extending the
// postui#34 (M4-008) boot-catalog pattern to a full variant matrix
// that catches state-dependent regressions the single-variant catalog
// smoke can miss:
//
//   * block:      with border (PLAIN) / without border (NONE + title)
//   * paragraph:  wrap=NONE / wrap=WORD
//   * list:       state=NULL (unselected) / state->selected=0
//   * table:      header_ptr=Line / header_ptr=0
//   * tabs:       1 tab, sel=0 / 3 tabs, sel=1
//   * scrollbar:  orientation=Vertical / orientation=Horizontal
//   * gauge:      kind=Bar / kind=Line
//   * sparkline:  value_count=1 / value_count=0
//   * barchart:   bar_count=1 / bar_count=5
//   * chart:      kind=Line (2 pts) / kind=Scatter (1 pt)
//   * canvas:     canvas_line drawn / canvas_clear only
//   * text_input: mode=SingleLine / mode=MultiLine
//   * tree:       leaf-only node / expanded root + 1 child
//   * calendar:   month=1 / month=7
//   * clear:      style=0 (default) / style=1 (custom)
//
// The M4-008 catalog smoke ("does every draw entrypoint stamp at least
// one cell without leaking past its Rect?") is a *regression corpus*
// for the module dispatch surface; this M5-005 matrix is a *variant
// corpus* for the state-dispatch inside each draw. A change that
// silently regresses the border=NONE fast path in block_draw, or the
// value_count=0 short-circuit in sparkline_draw, or the header_ptr=0
// branch in table_draw, would render fine under the M4-008 corpus but
// fail here.
//
// Each variant is verified against three properties (same shape as
// M4-008; the M4 rationale for skipping pixel-perfect fixtures over
// 30 golden files applies here at 2x the multiplier):
//
//   1. widget_draw returns 0 (no widget-specific error sentinel).
//   2. AT LEAST ONE non-zero cell exists inside the variant's Rect
//      tile (proves the variant wrote SOMETHING). Every widget in the
//      catalog is verified upstream to stamp non-zero cells even in
//      its "empty" state:
//        - sparkline with value_count=0 still fills the entire Rect
//          with space glyph (0x20) styled with style_track (see
//          sparkline.pdx Phase 1 fill).
//        - canvas with a cleared bitmap still stamps every cell with
//          the empty-braille glyph U+2800 = 0x0080A0E2 (see canvas.pdx
//          canvas_draw main loop).
//        - block with border=NONE + title=1 char stamps the title
//          glyph at (bx, by) (see block.pdx Phase 3 title path with
//          title_x_offset = r15!=0 ? 1 : 0; r15==0 for border=NONE
//          means title starts at bx).
//        - clear with style=0 stamps every cell with 0x20 (the space
//          glyph itself is non-zero; the style-only zero doesn't
//          collapse the fill).
//   3. Rect dimensions are respected. Verified via row 9, row 19, and
//      row 29 guard rows (240 qwords total). Same construction as
//      M4-008: every variant tile has y in {0, 10, 20} and h=9, so
//      every tile's y-range is disjoint from every guard row.
//
// =============================================================================
// FIXTURE (80 cols x 30 rows shared buffer, 30 tiles + 3 guard rows)
// =============================================================================
//
// Buffer: 80 cols x 30 rows x 16 B = 38400 B = 4800 u64 slots. @align(16)
//         so every (y*cols+x)*16 offset lands on a Cell boundary.
//
// Tile layout (10 tile cols x 3 tile rows = 30 slots; every tile is
// 8 cols wide x 9 rows tall; row 9, row 19, row 29 are GUARD rows
// separating tile rows, all-zero throughout the test):
//
//   x= 0 x= 8 x=16 x=24 x=32 x=40 x=48 x=56 x=64 x=72
//   +---++---++---++---++---++---++---++---++---++---+
//   |Blk||Blk||Par||Par||Lst||Lst||Tbl||Tbl||Tab||Tab|  y=0..9
//   | + || - ||NoW||WrW||nul||sel||hdr||nhd||1t0||3t1|
//   +---++---++---++---++---++---++---++---++---++---+
//     ~~~~~~~~~~~~~~~~~~~~~ row 9 GUARD ~~~~~~~~~~~~~~~~~~~~~
//   +---++---++---++---++---++---++---++---++---++---+
//   |ScV||ScH||GgB||GgL||SpV||Sp0||Br1||Br5||ChL||ChS|  y=10..19
//   +---++---++---++---++---++---++---++---++---++---+
//     ~~~~~~~~~~~~~~~~~~~~~ row 19 GUARD ~~~~~~~~~~~~~~~~~~~~
//   +---++---++---++---++---++---++---++---++---++---+
//   |CvL||CvC||TiS||TiM||TrL||TrE||Cl1||Cl7||Clr||Clr|  y=20..29
//   |ine||lr ||L  ||L  ||eaf||xp ||   ||   ||def||cst|
//   +---++---++---++---++---++---++---++---++---++---+
//     ~~~~~~~~~~~~~~~~~~~~~ row 29 GUARD ~~~~~~~~~~~~~~~~~~~~
//
// Variant-to-tile slot map (slot index === matrix draw ordinal):
//
//   slot  widget/variant                 rect (x, y, w, h)   byte offset
//   ----  ------------------------------ ------------------  -----------
//    0    block   / border PLAIN         ( 0,  0, 8, 9)                0
//    1    block   / no border + title    ( 8,  0, 8, 9)              128
//    2    para    / wrap NONE            (16,  0, 8, 9)              256
//    3    para    / wrap WORD            (24,  0, 8, 9)              384
//    4    list    / state NULL           (32,  0, 8, 9)              512
//    5    list    / state.selected=0     (40,  0, 8, 9)              640
//    6    table   / header_ptr!=0        (48,  0, 8, 9)              768
//    7    table   / header_ptr==0        (56,  0, 8, 9)              896
//    8    tabs    / 1 tab, sel=0         (64,  0, 8, 9)             1024
//    9    tabs    / 3 tabs, sel=1        (72,  0, 8, 9)             1152
//   10    scroll  / Vertical             ( 0, 10, 8, 9)            12800
//   11    scroll  / Horizontal           ( 8, 10, 8, 9)            12928
//   12    gauge   / Bar                  (16, 10, 8, 9)            13056
//   13    gauge   / Line                 (24, 10, 8, 9)            13184
//   14    spark   / 1 value              (32, 10, 8, 9)            13312
//   15    spark   / 0 values             (40, 10, 8, 9)            13440
//   16    bar     / 1 bar                (48, 10, 8, 9)            13568
//   17    bar     / 5 bars               (56, 10, 8, 9)            13696
//   18    chart   / Line (2 pts)         (64, 10, 8, 9)            13824
//   19    chart   / Scatter (1 pt)       (72, 10, 8, 9)            13952
//   20    canvas  / line drawn           ( 0, 20, 8, 9)            25600
//   21    canvas  / cleared only         ( 8, 20, 8, 9)            25728
//   22    tinput  / SingleLine           (16, 20, 8, 9)            25856
//   23    tinput  / MultiLine            (24, 20, 8, 9)            25984
//   24    tree    / leaf-only            (32, 20, 8, 9)            26112
//   25    tree    / expanded             (40, 20, 8, 9)            26240
//   26    cal     / month=1              (48, 20, 8, 9)            26368
//   27    cal     / month=7              (56, 20, 8, 9)            26496
//   28    clear   / style=0              (64, 20, 8, 9)            26624
//   29    clear   / style=1              (72, 20, 8, 9)            26752
//
// Guard rows: row 9 (byte offset 11520), row 19 (24320), row 29 (37120).
// 3 rows x 80 cols x 16 B = 3840 B = 480 qwords total to check
// (160 qwords per row).
//
// Every tile-top-left byte offset (0..26752) and every guard-row byte
// offset (11520..37120) is imm32-safe. Every packed-rect literal
// (0x0009000800000000..0x0009000800140048) is > 0x7FFFFFFF -> movabs.
//
// Row stride (BWCM_ROW_STRIDE) = 80 cols x 16 B = 1280 B (imm32-safe).
//
// =============================================================================
// PER-VARIANT MINIMAL SPEC (see design/architecture.md sec.5 wire tables)
// =============================================================================
//
// Every variant is set up with the smallest spec that guarantees the
// tile check passes AND that meaningfully exercises the variant-
// specific dispatch inside the widget:
//
//   block   / PLAIN   : border_kind=1, title="B", 4-corner + edge glyphs
//                       stamped in the tile.
//   block   / NONE    : border_kind=0, title="X", title glyph at (bx,by).
//   para    / NoWrap  : wrap=PARA_WRAP_NONE, alignment=Left, text="X".
//   para    / WordWrap: wrap=PARA_WRAP_WORD, alignment=Left, text="X".
//   list    / NULL    : state_ptr=0 -> decodes as selected=LIST_SELECTED_NONE.
//   list    / SEL     : state -> ListState(selected=0, offset=0).
//   table   / HDR     : header_ptr -> shared Line "X"; state.selected=0.
//   table   / NOHDR   : header_ptr=0; state.selected=0.
//   tabs    / 1T0     : 1 tab titled "X"; selected=0.
//   tabs    / 3T1     : 3 tabs all titled "X"; selected=1 (mid-selected).
//   scroll  / V       : orientation=0, content=10, viewport=5, position=2.
//   scroll  / H       : orientation=1, same v/c/p, exercises axis swap.
//   gauge   / Bar     : kind=0, value=50, max=100.
//   gauge   / Line    : kind=1, value=50, max=100.
//   spark   / N1      : 1 value=7, max_override=7 -> col 0 fills full height.
//   spark   / N0      : value_count=0 -> hits the value_count==0 fast path;
//                       the phase-1 space fill still stamps every cell.
//   bar     / 1B      : bars=[7], count=1, width=1, max=7.
//   bar     / 5B      : bars=[7,3,5,2,6], count=5, width=1, max=7.
//   chart   / LINE    : kind=0 (Line), 2 points (fx(0),fx(0)) & (fx(0),fx(8)),
//                       x_max=fx(8), y_max=fx(9) -> vertical line down col 0.
//   chart   / SCAT    : kind=1 (Scatter), 1 point (fx(0),fx(9)), y_max=fx(9)
//                       -- same shape as M4-008's chart slot.
//   canvas  / LINE    : canvas_clear + canvas_line((0,0)->(fx(15),fx(17)));
//                       braille dots trace a diagonal.
//   canvas  / CLR     : canvas_clear only. canvas_draw still stamps every
//                       cell with the empty-braille glyph U+2800 -- the
//                       braille glyph itself is non-zero.
//   tinput  / SL      : mode=0 (SingleLine), buffer="X", cursor at end.
//   tinput  / ML      : mode=1 (MultiLine), buffer="X", cursor at end.
//   tree    / LEAF    : root = TreeNode("X", 0 children, packed_flags=0).
//   tree    / EXP     : root = TreeNode("X", 1 child, packed_flags=(1<<63)|1),
//                       child = TreeNode("X", 0 children, packed_flags=0).
//   cal     / M1      : year=2026, month=1 (January), selected=0.
//   cal     / M7      : year=2026, month=7 (July),   selected=0.
//   clear   / S0      : style=0. word0 = 0x20 (space glyph, non-zero).
//   clear   / S1      : style=1. word0 = 0x20 | style bits, still non-zero.
//
// =============================================================================
// TILE-NON-EMPTY CHECK (wcm_tile_or_scan helper)
// =============================================================================
//
// Same fixed-geometry (8-col x 9-row) OR-reduction as M4-008
// (bwcs_tile_or_scan). Row stride = 80 * 16 = 1280 (BWCM_ROW_STRIDE).
// Returns the OR value in rax; a zero return means every cell in the
// tile is still zero -- the variant silently no-op'd.
//
// =============================================================================
// GUARD-ROW CHECK (post-matrix invariant)
// =============================================================================
//
// Rows 9, 19, 29 sit BETWEEN the three tile rows. No variant's Rect
// intersects any guard row (every variant has y in {0, 10, 20} and
// h=9; guard rows are {9, 19, 29}). After every variant's draw, a
// three-segment loop walks each guard row (80 cells x 2 qwords x 3
// rows = 480 qwords) and checks every qword is still zero. Any non-
// zero qword short-circuits to the shared tile-or-guard sentinel.
//
// =============================================================================
// FAIL SENTINELS (band 0xFFFFEDF0..0xFFFFEDFF)
// =============================================================================
//
// Anchored per design/architecture.md sec.7 (Fail-code family table).
// The M4-008 slot owns 0xFFFFEDD0..0xFFFFEDDF; M5-005 takes the next
// 16-slot band 0xFFFFEDF0..0xFFFFEDFF (M5 matrix slot). The band
// packs one sentinel per widget class (not per variant) plus one
// aggregate for tile-empty/guard:
//
//   * 15 widget-class draw-rc sentinels: any variant of that widget
//     that fails the rc == 0 check triggers the widget-class sentinel.
//     A debugger walks the source to attribute variant A vs B.
//   * 1 aggregate tile-empty/guard-violated sentinel shared across
//     every check-site.
//
//   0xFFFFEDF0  WCM_ERR_BLOCK_DRAW_RC       block_draw rc != 0 (either variant)
//   0xFFFFEDF1  WCM_ERR_PARAGRAPH_DRAW_RC   paragraph_draw rc != 0
//   0xFFFFEDF2  WCM_ERR_LIST_DRAW_RC        list_draw rc != 0
//   0xFFFFEDF3  WCM_ERR_TABLE_DRAW_RC       table_draw rc != 0
//   0xFFFFEDF4  WCM_ERR_TABS_DRAW_RC        tabs_draw rc != 0
//   0xFFFFEDF5  WCM_ERR_SCROLLBAR_DRAW_RC   scrollbar_draw rc != 0
//   0xFFFFEDF6  WCM_ERR_GAUGE_DRAW_RC       gauge_draw rc != 0
//   0xFFFFEDF7  WCM_ERR_SPARKLINE_DRAW_RC   sparkline_draw rc != 0
//   0xFFFFEDF8  WCM_ERR_BARCHART_DRAW_RC    barchart_draw rc != 0
//   0xFFFFEDF9  WCM_ERR_CHART_DRAW_RC       chart_draw rc != 0
//   0xFFFFEDFA  WCM_ERR_CANVAS_DRAW_RC      canvas_draw / clear / line rc
//   0xFFFFEDFB  WCM_ERR_TEXT_INPUT_DRAW_RC  text_input_draw rc != 0
//   0xFFFFEDFC  WCM_ERR_TREE_DRAW_RC        tree_draw rc != 0
//   0xFFFFEDFD  WCM_ERR_CALENDAR_DRAW_RC    calendar_draw rc != 0
//   0xFFFFEDFE  WCM_ERR_CLEAR_DRAW_RC       clear_draw rc != 0
//   0xFFFFEDFF  WCM_ERR_TILE_OR_GUARD       tile all-zero OR guard non-zero
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`WidgetCatalogMatrix`) matches
//     the file basename `widget_catalog_matrix.pdx`.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0` and every
//     small-value compare uses `cmp reg, imm` with imm <= 0x7FFFFFFF.
//   - Every packed rect literal (0x0009000800000000..0x0009000800140048)
//     is > 0x7FFFFFFF -> movabs. Every fail sentinel (0xFFFFEDFx) is
//     likewise a movabs.
//   - Fixed64 constants used in canvas_line / chart bounds
//     (fx(8)=0x0000000800000000, fx(9)=0x0000000900000000,
//     fx(15)=0x0000000F00000000, fx(17)=0x0000001100000000) are all
//     > 0x7FFFFFFF -> movabs.
//   - LIST_SELECTED_NONE is composed via `xor rsi, rsi; sub rsi, 1`
//     (list.pdx idiom), not via a movabs of 0xFFFFFFFFFFFFFFFF.
//   - Tree expanded-flag packed_flags = 0x8000000000000001 loaded via
//     movabs (imm > 0x7FFFFFFF, legal for mov).
//   - text_input buffer_len_and_cursor packed = 0x0000000100000001
//     (imm32-safe).
//   - No 2-op `imul reg, imm`; no imul in this module.
//   - No `and reg, imm64`; no `and` used at all.
//   - Single-line pub let for every string literal.
//   - r11 discipline: r11 is scratch inside the OR-scan and guard loops
//     as transit for the loaded qword, never preserved across a call.
//   - SysV alignment: `push rbx` (8 B) rounds SysV entry rsp%16==8 to 0
//     in wcm_tile_or_scan (leaf discipline anchor) and in the main
//     body. Every nested call (span_init, line_init, text_init,
//     list_state_init, table_state_init, layout_length, block_spec_init,
//     paragraph_spec_init, text_input_spec_init, fx_from_i64,
//     canvas_clear, canvas_line, and every <w>_draw) is SysV-conformant
//     and preserves rbx.
//   - Cross-module bare calls resolve via paideia-as's flat ELF symbol
//     namespace, matching M4-008 (boot_widget_catalog_smoke.pdx).
//   - Effect row `!{mem} @{}` on widget_catalog_matrix_smoke -- writes
//     to every fixture slab and the shared buffer transitively.
//   - Labels prefixed `wcm_` per docs fingerprint discipline.

module WidgetCatalogMatrix = structure {

  // ==========================================================================
  // Fail sentinels (band 0xFFFFEDF0..0xFFFFEDFF per architecture.md sec.7)
  // ==========================================================================
  pub let WCM_ERR_BLOCK_DRAW_RC      : u64 = 0xFFFFEDF0
  pub let WCM_ERR_PARAGRAPH_DRAW_RC  : u64 = 0xFFFFEDF1
  pub let WCM_ERR_LIST_DRAW_RC       : u64 = 0xFFFFEDF2
  pub let WCM_ERR_TABLE_DRAW_RC      : u64 = 0xFFFFEDF3
  pub let WCM_ERR_TABS_DRAW_RC       : u64 = 0xFFFFEDF4
  pub let WCM_ERR_SCROLLBAR_DRAW_RC  : u64 = 0xFFFFEDF5
  pub let WCM_ERR_GAUGE_DRAW_RC      : u64 = 0xFFFFEDF6
  pub let WCM_ERR_SPARKLINE_DRAW_RC  : u64 = 0xFFFFEDF7
  pub let WCM_ERR_BARCHART_DRAW_RC   : u64 = 0xFFFFEDF8
  pub let WCM_ERR_CHART_DRAW_RC      : u64 = 0xFFFFEDF9
  pub let WCM_ERR_CANVAS_DRAW_RC     : u64 = 0xFFFFEDFA
  pub let WCM_ERR_TEXT_INPUT_DRAW_RC : u64 = 0xFFFFEDFB
  pub let WCM_ERR_TREE_DRAW_RC       : u64 = 0xFFFFEDFC
  pub let WCM_ERR_CALENDAR_DRAW_RC   : u64 = 0xFFFFEDFD
  pub let WCM_ERR_CLEAR_DRAW_RC      : u64 = 0xFFFFEDFE
  pub let WCM_ERR_TILE_OR_GUARD      : u64 = 0xFFFFEDFF

  // ==========================================================================
  // Fixture-shape constants (exported for downstream harness reuse).
  // ==========================================================================
  pub let WCM_ROWS         : u64 = 30
  pub let WCM_COLS         : u64 = 80
  pub let WCM_TILE_W       : u64 = 8
  pub let WCM_TILE_H       : u64 = 9
  pub let WCM_ROW_STRIDE   : u64 = 1280    // 80 cols * 16 B/cell
  pub let WCM_VARIANT_COUNT: u64 = 30

  // ==========================================================================
  // Static UTF-8 byte runs. Single-line pub let per paideia-as pitfall.
  // ==========================================================================
  pub let _wcm_str_b : [u8; 1] = "B"
  pub let _wcm_str_x : [u8; 1] = "X"

  // ==========================================================================
  // Shared buffer: 80 cols x 30 rows x 16 B = 38400 B = 4800 u64 slots.
  // @align(16) so every (y*cols+x)*16 offset lands on a Cell boundary.
  // ==========================================================================
  pub let mut _wcm_buffer : [u64; 4800] = uninit @align(16)

  // ==========================================================================
  // Shared auxiliary data (Span "X", Line, Text) reused by every text-
  // consuming variant. Immutable to draw paths.
  // ==========================================================================
  pub let mut _wcm_span_x : [u64; 3] = uninit @align(8)
  pub let mut _wcm_line_x : [u64; 3] = uninit @align(8)
  pub let mut _wcm_text_x : [u64; 2] = uninit @align(8)

  // ==========================================================================
  // Per-variant spec slabs. Two per widget (30 total). Each spec's size
  // matches its widget's WIRE section in the source module.
  // ==========================================================================

  // Slot 0/1: BLOCK (48 B = 6 u64 each)
  pub let mut _wcm_block_a_spec : [u64; 6] = uninit @align(16)
  pub let mut _wcm_block_b_spec : [u64; 6] = uninit @align(16)

  // Slot 2/3: PARAGRAPH (48 B = 6 u64 each)
  pub let mut _wcm_para_a_spec : [u64; 6] = uninit @align(8)
  pub let mut _wcm_para_b_spec : [u64; 6] = uninit @align(8)

  // Slot 4/5: LIST (64 B = 8 u64 each) + ListState (24 B = 3 u64) for
  // the selected variant only.
  pub let mut _wcm_list_a_spec  : [u64; 8] = uninit @align(8)
  pub let mut _wcm_list_b_spec  : [u64; 8] = uninit @align(8)
  pub let mut _wcm_list_b_state : [u64; 3] = uninit @align(8)

  // Slot 6/7: TABLE (80 B = 10 u64 each). Header-variant needs a Line
  // slot (24 B = 3 u64) for the header. Both share a single TableRow,
  // Constraint, and TableState set (state.selected=0 for both).
  pub let mut _wcm_table_a_spec        : [u64; 10] = uninit @align(8)
  pub let mut _wcm_table_b_spec        : [u64; 10] = uninit @align(8)
  pub let mut _wcm_table_row           : [u64; 2]  = uninit @align(8)
  pub let mut _wcm_table_constraints   : [u64; 1]  = uninit @align(8)
  pub let mut _wcm_table_state_a       : [u64; 3]  = uninit @align(8)
  pub let mut _wcm_table_state_b       : [u64; 3]  = uninit @align(8)
  pub let mut _wcm_table_header_line   : [u64; 3]  = uninit @align(8)

  // Slot 8/9: TABS (56 B = 7 u64 each). 3-tabs variant needs a 3-span
  // array (72 B = 9 u64) so the tabs_draw loop walks three distinct
  // slots even though every span points at the same "X" bytes.
  pub let mut _wcm_tabs_a_spec  : [u64; 7] = uninit @align(8)
  pub let mut _wcm_tabs_b_spec  : [u64; 7] = uninit @align(8)
  pub let mut _wcm_tabs_b_spans : [u64; 9] = uninit @align(8)

  // Slot 10/11: SCROLLBAR (56 B = 7 u64 each)
  pub let mut _wcm_scroll_a_spec : [u64; 7] = uninit @align(8)
  pub let mut _wcm_scroll_b_spec : [u64; 7] = uninit @align(8)

  // Slot 12/13: GAUGE (48 B = 6 u64 each)
  pub let mut _wcm_gauge_a_spec : [u64; 6] = uninit @align(8)
  pub let mut _wcm_gauge_b_spec : [u64; 6] = uninit @align(8)

  // Slot 14/15: SPARKLINE (40 B = 5 u64 each) + values (1 u64) for the
  // non-empty variant only. Empty variant's values_ptr is 0.
  pub let mut _wcm_spark_a_spec   : [u64; 5] = uninit @align(8)
  pub let mut _wcm_spark_b_spec   : [u64; 5] = uninit @align(8)
  pub let mut _wcm_spark_a_values : [u64; 1] = uninit @align(8)

  // Slot 16/17: BARCHART (64 B = 8 u64 each) + bars (1 u64 for 1-bar,
  // 5 u64 for 5-bar variant).
  pub let mut _wcm_bar_a_spec : [u64; 8] = uninit @align(8)
  pub let mut _wcm_bar_b_spec : [u64; 8] = uninit @align(8)
  pub let mut _wcm_bar_a_bars : [u64; 1] = uninit @align(8)
  pub let mut _wcm_bar_b_bars : [u64; 5] = uninit @align(8)

  // Slot 18/19: CHART (72 B = 9 u64 each) + dataset (32 B = 4 u64) +
  // points (2 u64 per point). Line variant has 2 points, Scatter has 1.
  pub let mut _wcm_chart_a_spec    : [u64; 9] = uninit @align(8)
  pub let mut _wcm_chart_b_spec    : [u64; 9] = uninit @align(8)
  pub let mut _wcm_chart_a_dataset : [u64; 4] = uninit @align(8)
  pub let mut _wcm_chart_b_dataset : [u64; 4] = uninit @align(8)
  pub let mut _wcm_chart_a_points  : [u64; 4] = uninit @align(8)
  pub let mut _wcm_chart_b_points  : [u64; 2] = uninit @align(8)

  // Slot 20/21: CANVAS (64 B = 8 u64 each) + bitmap (bw*bh = 72 B = 9
  // u64 each). Both variants call canvas_clear + canvas_draw; the LINE
  // variant additionally calls canvas_line before canvas_draw.
  pub let mut _wcm_canvas_a_spec   : [u64; 8] = uninit @align(8)
  pub let mut _wcm_canvas_b_spec   : [u64; 8] = uninit @align(8)
  pub let mut _wcm_canvas_a_bitmap : [u64; 9] = uninit @align(8)
  pub let mut _wcm_canvas_b_bitmap : [u64; 9] = uninit @align(8)

  // Slot 22/23: TEXT_INPUT (72 B = 9 u64 each) + buffer (2 u64) each.
