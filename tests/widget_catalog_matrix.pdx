        // ==================================================================
        lea rdi, [rip + _wcm_table_state_b];
        xor rsi, rsi;
        xor rdx, rdx;
        call table_state_init;

        lea rbx, [rip + _wcm_table_b_spec];
        mov rax, 0x0009000800000038;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_table_row];
        mov [rbx + 8], rax;                 // rows_ptr
        mov rax, 1;
        mov [rbx + 16], rax;                // row_count
        lea rax, [rip + _wcm_table_constraints];
        mov [rbx + 24], rax;                // constraints_ptr
        mov rax, 1;
        mov [rbx + 32], rax;                // column_count
        xor rax, rax;
        mov [rbx + 40], rax;                // header_ptr = 0 (NO HEADER)
        lea rax, [rip + _wcm_table_state_b];
        mov [rbx + 48], rax;                // state_ptr
        xor rax, rax;
        mov [rbx + 56], rax;                // highlight_style
        mov [rbx + 64], rax;                // default_style
        mov [rbx + 72], rax;                // reserved

        lea rdi, [rip + _wcm_table_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call table_draw;
        cmp rax, 0;
        jne wcm_fail_table_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 896;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 10: slot 8 -- TABS / 1-tab sel=0 at (64, 0, 8, 9).
        // Direct-store TabsSpec (56 B, 7 slots) with the shared _wcm_span_x
        // as its single-tab titles array.
        // ==================================================================
        lea rbx, [rip + _wcm_tabs_a_spec];
        mov rax, 0x0009000800000040;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_span_x];
        mov [rbx + 8], rax;                 // titles_ptr
        mov rax, 1;
        mov [rbx + 16], rax;                // tab_count = 1
        xor rax, rax;
        mov [rbx + 24], rax;                // selected = 0 (first)
        mov [rbx + 32], rax;                // divider (0 = default)
        mov [rbx + 40], rax;                // style_active
        mov [rbx + 48], rax;                // style_inactive

        lea rdi, [rip + _wcm_tabs_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call tabs_draw;
        cmp rax, 0;
        jne wcm_fail_tabs_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 1024;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 11: slot 9 -- TABS / 3-tab sel=1 at (72, 0, 8, 9).
        // Build 3 Span slots (72 B), each pointing at _wcm_str_x, then
        // direct-store TabsSpec with selected=1 (mid-selected).
        // ==================================================================
        // _wcm_tabs_b_spans[0..3] direct-store (each Span 24 B).
        lea rbx, [rip + _wcm_tabs_b_spans];
        lea rax, [rip + _wcm_str_x];
        mov [rbx + 0], rax;                 // spans[0].ptr
        mov rax, 1;
        mov [rbx + 8], rax;                 // spans[0].byte_len
        xor rax, rax;
        mov [rbx + 16], rax;                // spans[0].style
        lea rax, [rip + _wcm_str_x];
        mov [rbx + 24], rax;                // spans[1].ptr
        mov rax, 1;
        mov [rbx + 32], rax;                // spans[1].byte_len
        xor rax, rax;
        mov [rbx + 40], rax;                // spans[1].style
        lea rax, [rip + _wcm_str_x];
        mov [rbx + 48], rax;                // spans[2].ptr
        mov rax, 1;
        mov [rbx + 56], rax;                // spans[2].byte_len
        xor rax, rax;
        mov [rbx + 64], rax;                // spans[2].style

        lea rbx, [rip + _wcm_tabs_b_spec];
        mov rax, 0x0009000800000048;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_tabs_b_spans];
        mov [rbx + 8], rax;                 // titles_ptr
        mov rax, 3;
        mov [rbx + 16], rax;                // tab_count = 3
        mov rax, 1;
        mov [rbx + 24], rax;                // selected = 1 (mid)
        xor rax, rax;
        mov [rbx + 32], rax;                // divider
        mov [rbx + 40], rax;                // style_active
        mov [rbx + 48], rax;                // style_inactive

        lea rdi, [rip + _wcm_tabs_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call tabs_draw;
        cmp rax, 0;
        jne wcm_fail_tabs_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 1152;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 12: slot 10 -- SCROLLBAR / Vertical at (0, 10, 8, 9).
        // Direct-store ScrollbarSpec (56 B, 7 slots).
        // ==================================================================
        lea rbx, [rip + _wcm_scroll_a_spec];
        mov rax, 0x00090008000A0000;
        mov [rbx + 0], rax;                 // rect
        xor rax, rax;
        mov [rbx + 8], rax;                 // orientation = 0 (V)
        mov rax, 2;
        mov [rbx + 16], rax;                // position = 2
        mov rax, 10;
        mov [rbx + 24], rax;                // content_length = 10
        mov rax, 5;
        mov [rbx + 32], rax;                // viewport_length = 5
        mov rax, 1;
        mov [rbx + 40], rax;                // style_track = 1
        mov rax, 2;
        mov [rbx + 48], rax;                // style_thumb = 2

        lea rdi, [rip + _wcm_scroll_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call scrollbar_draw;
        cmp rax, 0;
        jne wcm_fail_scrollbar_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 12800;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 13: slot 11 -- SCROLLBAR / Horizontal at (8, 10, 8, 9).
        // ==================================================================
        lea rbx, [rip + _wcm_scroll_b_spec];
        mov rax, 0x00090008000A0008;
        mov [rbx + 0], rax;                 // rect
        mov rax, 1;
        mov [rbx + 8], rax;                 // orientation = 1 (H)
        mov rax, 2;
        mov [rbx + 16], rax;                // position = 2
        mov rax, 10;
        mov [rbx + 24], rax;                // content_length = 10
        mov rax, 5;
        mov [rbx + 32], rax;                // viewport_length = 5
        mov rax, 1;
        mov [rbx + 40], rax;                // style_track = 1
        mov rax, 2;
        mov [rbx + 48], rax;                // style_thumb = 2

        lea rdi, [rip + _wcm_scroll_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call scrollbar_draw;
        cmp rax, 0;
        jne wcm_fail_scrollbar_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 12928;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 14: slot 12 -- GAUGE / Bar at (16, 10, 8, 9).
        // Direct-store GaugeSpec (48 B, 6 slots).
        // ==================================================================
        lea rbx, [rip + _wcm_gauge_a_spec];
        mov rax, 0x00090008000A0010;
        mov [rbx + 0], rax;                 // rect
        mov rax, 50;
        mov [rbx + 8], rax;                 // value = 50
        mov rax, 100;
        mov [rbx + 16], rax;                // max = 100
        xor rax, rax;
        mov [rbx + 24], rax;                // kind = 0 (Bar)
        mov rax, 1;
        mov [rbx + 32], rax;                // style_filled
        xor rax, rax;
        mov [rbx + 40], rax;                // style_empty

        lea rdi, [rip + _wcm_gauge_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call gauge_draw;
        cmp rax, 0;
        jne wcm_fail_gauge_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13056;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 15: slot 13 -- GAUGE / Line at (24, 10, 8, 9).
        // ==================================================================
        lea rbx, [rip + _wcm_gauge_b_spec];
        mov rax, 0x00090008000A0018;
        mov [rbx + 0], rax;                 // rect
        mov rax, 50;
        mov [rbx + 8], rax;                 // value = 50
        mov rax, 100;
        mov [rbx + 16], rax;                // max = 100
        mov rax, 1;
        mov [rbx + 24], rax;                // kind = 1 (Line)
        mov [rbx + 32], rax;                // style_filled
        xor rax, rax;
        mov [rbx + 40], rax;                // style_empty

        lea rdi, [rip + _wcm_gauge_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call gauge_draw;
        cmp rax, 0;
        jne wcm_fail_gauge_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13184;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 16: slot 14 -- SPARKLINE / 1 value at (32, 10, 8, 9).
        // 1 value=7 with max_override=7 -> column 0 fills full height.
        // ==================================================================
        lea rbx, [rip + _wcm_spark_a_values];
        mov rax, 7;
        mov [rbx + 0], rax;                 // values[0] = 7

        lea rbx, [rip + _wcm_spark_a_spec];
        mov rax, 0x00090008000A0020;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_spark_a_values];
        mov [rbx + 8], rax;                 // values_ptr
        mov rax, 1;
        mov [rbx + 16], rax;                // value_count = 1
        mov rax, 7;
        mov [rbx + 24], rax;                // max_override = 7
        mov rax, 1;
        mov [rbx + 32], rax;                // style = 1

        lea rdi, [rip + _wcm_spark_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call sparkline_draw;
        cmp rax, 0;
        jne wcm_fail_sparkline_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13312;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 17: slot 15 -- SPARKLINE / value_count=0 at (40, 10, 8, 9).
        // value_count=0 hits the empty-input fast path; sparkline.pdx
        // Phase 1 still fills the entire Rect with space glyph (0x20)
        // styled with style_track, which yields non-zero cells.
        // ==================================================================
        lea rbx, [rip + _wcm_spark_b_spec];
        mov rax, 0x00090008000A0028;
        mov [rbx + 0], rax;                 // rect
        xor rax, rax;
        mov [rbx + 8], rax;                 // values_ptr = 0
        mov [rbx + 16], rax;                // value_count = 0
        mov [rbx + 24], rax;                // max_override = 0
        mov rax, 1;
        mov [rbx + 32], rax;                // style = 1 (keeps cells non-zero on fill)

        lea rdi, [rip + _wcm_spark_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call sparkline_draw;
        cmp rax, 0;
        jne wcm_fail_sparkline_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13440;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 18: slot 16 -- BARCHART / 1 bar at (48, 10, 8, 9).
        // ==================================================================
        lea rbx, [rip + _wcm_bar_a_bars];
        mov rax, 7;
        mov [rbx + 0], rax;                 // bars[0] = 7

        lea rbx, [rip + _wcm_bar_a_spec];
        mov rax, 0x00090008000A0030;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_bar_a_bars];
        mov [rbx + 8], rax;                 // bars_ptr
        mov rax, 1;
        mov [rbx + 16], rax;                // bar_count = 1
        mov [rbx + 24], rax;                // bar_width = 1
        xor rax, rax;
        mov [rbx + 32], rax;                // gap = 0
        mov rax, 7;
        mov [rbx + 40], rax;                // max_override = 7
        mov rax, 1;
        mov [rbx + 48], rax;                // style_bar = 1
        xor rax, rax;
        mov [rbx + 56], rax;                // style_bg = 0

        lea rdi, [rip + _wcm_bar_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call barchart_draw;
        cmp rax, 0;
        jne wcm_fail_barchart_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13568;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 19: slot 17 -- BARCHART / 5 bars at (56, 10, 8, 9).
        // ==================================================================
        lea rbx, [rip + _wcm_bar_b_bars];
        mov rax, 7;
        mov [rbx + 0], rax;                 // bars[0] = 7
        mov rax, 3;
        mov [rbx + 8], rax;                 // bars[1] = 3
        mov rax, 5;
        mov [rbx + 16], rax;                // bars[2] = 5
        mov rax, 2;
        mov [rbx + 24], rax;                // bars[3] = 2
        mov rax, 6;
        mov [rbx + 32], rax;                // bars[4] = 6

        lea rbx, [rip + _wcm_bar_b_spec];
        mov rax, 0x00090008000A0038;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_bar_b_bars];
        mov [rbx + 8], rax;                 // bars_ptr
        mov rax, 5;
        mov [rbx + 16], rax;                // bar_count = 5
        mov rax, 1;
        mov [rbx + 24], rax;                // bar_width = 1
        xor rax, rax;
        mov [rbx + 32], rax;                // gap = 0
        mov rax, 7;
        mov [rbx + 40], rax;                // max_override = 7
        mov rax, 1;
        mov [rbx + 48], rax;                // style_bar = 1
        xor rax, rax;
        mov [rbx + 56], rax;                // style_bg = 0

        lea rdi, [rip + _wcm_bar_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call barchart_draw;
        cmp rax, 0;
        jne wcm_fail_barchart_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13696;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 20: slot 18 -- CHART / Line (2 pts) at (64, 10, 8, 9).
        // 2 points (fx(0), fx(0)) and (fx(0), fx(8)) with x_max=fx(8),
        // y_max=fx(9). Both points map to column 0; Bresenham stamps a
        // vertical line across the tile column.
        // ==================================================================
        mov rdi, 0;
        call fx_from_i64;
        lea rbx, [rip + _wcm_chart_a_points];
        mov [rbx + 0], rax;                 // points[0].x_fx = fx(0)
        mov [rbx + 8], rax;                 // points[0].y_fx = fx(0)
        mov [rbx + 16], rax;                // points[1].x_fx = fx(0)
        mov rdi, 8;
        call fx_from_i64;
        lea rbx, [rip + _wcm_chart_a_points];
        mov [rbx + 24], rax;                // points[1].y_fx = fx(8)

        // Dataset direct-store (32 B, 4 slots).
        lea rbx, [rip + _wcm_chart_a_dataset];
        lea rax, [rip + _wcm_chart_a_points];
        mov [rbx + 0], rax;                 // points_ptr
        mov rax, 2;
        mov [rbx + 8], rax;                 // point_count = 2
        xor rax, rax;
        mov [rbx + 16], rax;                // kind = 0 (Line)
        mov [rbx + 24], rax;                // marker = 0 (default)

        // ChartSpec direct-store (72 B, 9 slots).
        lea rbx, [rip + _wcm_chart_a_spec];
        mov rax, 0x00090008000A0040;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_chart_a_dataset];
        mov [rbx + 8], rax;                 // datasets_ptr
        mov rax, 1;
        mov [rbx + 16], rax;                // dataset_count = 1
        xor rax, rax;
        mov [rbx + 24], rax;                // x_min = fx(0)
        mov rax, 0x0000000800000000;
        mov [rbx + 32], rax;                // x_max = fx(8) (movabs)
        xor rax, rax;
        mov [rbx + 40], rax;                // y_min = fx(0)
        mov rax, 0x0000000900000000;
        mov [rbx + 48], rax;                // y_max = fx(9) (movabs)
        mov rax, 1;
        mov [rbx + 56], rax;                // style_line = 1
        xor rax, rax;
        mov [rbx + 64], rax;                // style_axis (reserved)

        lea rdi, [rip + _wcm_chart_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call chart_draw;
        cmp rax, 0;
        jne wcm_fail_chart_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13824;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 21: slot 19 -- CHART / Scatter (1 pt) at (72, 10, 8, 9).
        // 1 point (fx(0), fx(0)) with x_max=fx(8), y_max=fx(9) -- inherits
        // M4-008's scatter shape; marker glyph stamps at bottom-left cell.
        // ==================================================================
        mov rdi, 0;
        call fx_from_i64;
        lea rbx, [rip + _wcm_chart_b_points];
        mov [rbx + 0], rax;                 // points[0].x_fx = fx(0)
        mov [rbx + 8], rax;                 // points[0].y_fx = fx(0)

        // Dataset direct-store.
        lea rbx, [rip + _wcm_chart_b_dataset];
        lea rax, [rip + _wcm_chart_b_points];
        mov [rbx + 0], rax;                 // points_ptr
        mov rax, 1;
        mov [rbx + 8], rax;                 // point_count = 1
        mov [rbx + 16], rax;                // kind = 1 (Scatter)
        xor rax, rax;
        mov [rbx + 24], rax;                // marker = 0 (default)

        lea rbx, [rip + _wcm_chart_b_spec];
        mov rax, 0x00090008000A0048;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_chart_b_dataset];
        mov [rbx + 8], rax;                 // datasets_ptr
        mov rax, 1;
        mov [rbx + 16], rax;                // dataset_count = 1
        xor rax, rax;
        mov [rbx + 24], rax;                // x_min = fx(0)
        mov rax, 0x0000000800000000;
        mov [rbx + 32], rax;                // x_max = fx(8)
        xor rax, rax;
        mov [rbx + 40], rax;                // y_min = fx(0)
        mov rax, 0x0000000900000000;
        mov [rbx + 48], rax;                // y_max = fx(9)
        mov rax, 1;
        mov [rbx + 56], rax;                // style_line = 1
        xor rax, rax;
        mov [rbx + 64], rax;                // style_axis

        lea rdi, [rip + _wcm_chart_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call chart_draw;
        cmp rax, 0;
        jne wcm_fail_chart_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 13952;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 22: slot 20 -- CANVAS / line drawn at (0, 20, 8, 9).
        // Direct-store CanvasSpec then canvas_clear + canvas_line(...) +
        // canvas_draw. Same shape as M4-008 (line covers a diagonal
        // stamping braille dots).
        // ==================================================================
        lea rbx, [rip + _wcm_canvas_a_spec];
        mov rax, 0x0009000800140000;
        mov [rbx + 0], rax;                 // rect
        xor rax, rax;
        mov [rbx + 8], rax;                 // x_min = fx(0)
        mov rax, 0x0000001000000000;
        mov [rbx + 16], rax;                // x_max = fx(16)
        xor rax, rax;
        mov [rbx + 24], rax;                // y_min = fx(0)
        mov rax, 0x0000001200000000;
        mov [rbx + 32], rax;                // y_max = fx(18)
        lea rax, [rip + _wcm_canvas_a_bitmap];
        mov [rbx + 40], rax;                // bitmap_ptr
        mov rax, 1;
        mov [rbx + 48], rax;                // style = 1
        xor rax, rax;
        mov [rbx + 56], rax;                // _reserved

        lea rdi, [rip + _wcm_canvas_a_spec];
        call canvas_clear;
        cmp rax, 0;
        jne wcm_fail_canvas_rc;

        lea rdi, [rip + _wcm_canvas_a_spec];
        xor rsi, rsi;                       // x0 = fx(0)
        xor rdx, rdx;                       // y0 = fx(0)
        mov rcx, 0x0000000F00000000;        // x1 = fx(15)
        mov r8,  0x0000001100000000;        // y1 = fx(17)
        call canvas_line;
        cmp rax, 0;
        jne wcm_fail_canvas_rc;

        lea rdi, [rip + _wcm_canvas_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call canvas_draw;
        cmp rax, 0;
        jne wcm_fail_canvas_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 25600;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 23: slot 21 -- CANVAS / cleared only at (8, 20, 8, 9).
        // canvas_clear + canvas_draw (no canvas_line). canvas_draw still
        // stamps every cell with the empty-braille glyph U+2800 =
        // 0x0080A0E2 (see canvas.pdx canvas_draw main loop) -- the
        // braille base glyph is non-zero even when the bitmap is all-zero.
        // ==================================================================
        lea rbx, [rip + _wcm_canvas_b_spec];
        mov rax, 0x0009000800140008;
        mov [rbx + 0], rax;                 // rect
        xor rax, rax;
        mov [rbx + 8], rax;                 // x_min
        mov rax, 0x0000001000000000;
        mov [rbx + 16], rax;                // x_max = fx(16)
        xor rax, rax;
        mov [rbx + 24], rax;                // y_min
        mov rax, 0x0000001200000000;
        mov [rbx + 32], rax;                // y_max = fx(18)
        lea rax, [rip + _wcm_canvas_b_bitmap];
        mov [rbx + 40], rax;                // bitmap_ptr
        mov rax, 1;
        mov [rbx + 48], rax;                // style = 1
        xor rax, rax;
        mov [rbx + 56], rax;                // _reserved

        lea rdi, [rip + _wcm_canvas_b_spec];
        call canvas_clear;
        cmp rax, 0;
        jne wcm_fail_canvas_rc;

        lea rdi, [rip + _wcm_canvas_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call canvas_draw;
        cmp rax, 0;
        jne wcm_fail_canvas_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 25728;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 24: slot 22 -- TEXT_INPUT / SingleLine at (16, 20, 8, 9).
        // Stamp 'X' at buffer[0], compose spec via text_input_spec_init.
        //   buffer_len_and_cursor = 1 (len) | 1<<32 (cursor)
        //                         = 0x0000000100000001 (imm32-safe)
        //   scroll_and_mode       = 0 (mode = SingleLine)
        // ==================================================================
        lea rbx, [rip + _wcm_ti_a_buffer];
        mov rax, 0x58;                      // 'X' == 0x58
        mov_b [rbx + 0], rax;

        lea rdi, [rip + _wcm_ti_a_spec];
        mov rsi, 0x0009000800140010;
        lea rdx, [rip + _wcm_ti_a_buffer];
        mov rcx, 16;
        mov r8, 0x0000000100000001;
        xor r9, r9;
        call text_input_spec_init;

        lea rdi, [rip + _wcm_ti_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call text_input_draw;
        cmp rax, 0;
        jne wcm_fail_text_input_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 25856;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 25: slot 23 -- TEXT_INPUT / MultiLine at (24, 20, 8, 9).
        // scroll_and_mode = 1 (mode = MultiLine).
        // ==================================================================
        lea rbx, [rip + _wcm_ti_b_buffer];
        mov rax, 0x58;                      // 'X'
        mov_b [rbx + 0], rax;

        lea rdi, [rip + _wcm_ti_b_spec];
        mov rsi, 0x0009000800140018;
        lea rdx, [rip + _wcm_ti_b_buffer];
        mov rcx, 16;
        mov r8, 0x0000000100000001;
        mov r9, 1;                          // mode = MultiLine (low 32)
        call text_input_spec_init;

        lea rdi, [rip + _wcm_ti_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call text_input_draw;
        cmp rax, 0;
        jne wcm_fail_text_input_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 25984;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 26: slot 24 -- TREE / leaf-only at (32, 20, 8, 9).
        // Root TreeNode with 0 children, packed_flags=0 (not expanded,
        // count=0). tree_draw stamps the label at row 0.
        // ==================================================================
        lea rbx, [rip + _wcm_tree_a_root];
        lea rax, [rip + _wcm_str_x];
        mov [rbx + 0], rax;                 // label_ptr
        mov rax, 1;
        mov [rbx + 8], rax;                 // label_len = 1
        xor rax, rax;
        mov [rbx + 16], rax;                // children_ptr = 0
        mov [rbx + 24], rax;                // packed_flags = 0 (leaf)

        lea rbx, [rip + _wcm_tree_a_spec];
        mov rax, 0x0009000800140020;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_tree_a_root];
        mov [rbx + 8], rax;                 // root_ptr
        xor rax, rax;
        mov [rbx + 16], rax;                // selected_ptr
        mov [rbx + 24], rax;                // state_ptr
        mov rax, 1;
        mov [rbx + 32], rax;                // style_line = 1
        xor rax, rax;
        mov [rbx + 40], rax;                // style_selected
        mov [rbx + 48], rax;                // _reserved_a
        mov [rbx + 56], rax;                // _reserved_b

        lea rdi, [rip + _wcm_tree_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call tree_draw;
        cmp rax, 0;
        jne wcm_fail_tree_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 26112;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 27: slot 25 -- TREE / expanded at (40, 20, 8, 9).
        // Root TreeNode with 1 child, packed_flags = bit 63 (expanded) |
        // 1 (child_count) = 0x8000000000000001 (movabs). tree_draw walks
        // root + child (DFS).
        // ==================================================================
        // Child node.
        lea rbx, [rip + _wcm_tree_b_child];
        lea rax, [rip + _wcm_str_x];
        mov [rbx + 0], rax;                 // label_ptr
        mov rax, 1;
        mov [rbx + 8], rax;                 // label_len = 1
        xor rax, rax;
        mov [rbx + 16], rax;                // children_ptr = 0
        mov [rbx + 24], rax;                // packed_flags = 0

        // Root node.
        lea rbx, [rip + _wcm_tree_b_root];
        lea rax, [rip + _wcm_str_x];
        mov [rbx + 0], rax;                 // label_ptr
        mov rax, 1;
        mov [rbx + 8], rax;                 // label_len = 1
        lea rax, [rip + _wcm_tree_b_child];
        mov [rbx + 16], rax;                // children_ptr
        mov rax, 0x8000000000000001;        // bit 63 = expanded, count = 1
        mov [rbx + 24], rax;                // packed_flags

        lea rbx, [rip + _wcm_tree_b_spec];
        mov rax, 0x0009000800140028;
        mov [rbx + 0], rax;                 // rect
        lea rax, [rip + _wcm_tree_b_root];
        mov [rbx + 8], rax;                 // root_ptr
        xor rax, rax;
        mov [rbx + 16], rax;                // selected_ptr
        mov [rbx + 24], rax;                // state_ptr
        mov rax, 1;
        mov [rbx + 32], rax;                // style_line
        xor rax, rax;
        mov [rbx + 40], rax;                // style_selected
        mov [rbx + 48], rax;                // _reserved_a
        mov [rbx + 56], rax;                // _reserved_b

        lea rdi, [rip + _wcm_tree_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call tree_draw;
        cmp rax, 0;
        jne wcm_fail_tree_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 26240;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 28: slot 26 -- CALENDAR / month=1 at (48, 20, 8, 9).
        // year=2026, month=1 (January), selected_day=0. bw=8 >= 8 keeps
        // the header row; bh=9 >= 3 keeps the grid.
        // ==================================================================
        lea rbx, [rip + _wcm_cal_a_spec];
        mov rax, 0x0009000800140030;
        mov [rbx + 0], rax;                 // rect
        mov rax, 2026;
        mov [rbx + 8], rax;                 // year
        mov rax, 1;
        mov [rbx + 16], rax;                // month = 1
        xor rax, rax;
        mov [rbx + 24], rax;                // selected_day
        mov rax, 1;
        mov [rbx + 32], rax;                // style_normal = 1
        xor rax, rax;
        mov [rbx + 40], rax;                // style_selected

        lea rdi, [rip + _wcm_cal_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call calendar_draw;
        cmp rax, 0;
        jne wcm_fail_calendar_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 26368;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 29: slot 27 -- CALENDAR / month=7 at (56, 20, 8, 9).
        // Exercises the mid-year branch of the days_in_month and
        // weekday_of_first paths.
        // ==================================================================
        lea rbx, [rip + _wcm_cal_b_spec];
        mov rax, 0x0009000800140038;
        mov [rbx + 0], rax;                 // rect
        mov rax, 2026;
        mov [rbx + 8], rax;                 // year
        mov rax, 7;
        mov [rbx + 16], rax;                // month = 7 (July)
        xor rax, rax;
        mov [rbx + 24], rax;                // selected_day
        mov rax, 1;
        mov [rbx + 32], rax;                // style_normal
        xor rax, rax;
        mov [rbx + 40], rax;                // style_selected

        lea rdi, [rip + _wcm_cal_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call calendar_draw;
        cmp rax, 0;
        jne wcm_fail_calendar_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 26496;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 30: slot 28 -- CLEAR / style=0 at (64, 20, 8, 9).
        // clear_draw stamps every cell with (0x20, style=0). The space
        // glyph alone (0x20) makes word0 non-zero even with zero style,
        // so the tile check passes.
        // ==================================================================
        lea rbx, [rip + _wcm_clear_a_spec];
        mov rax, 0x0009000800140040;
        mov [rbx + 0], rax;                 // rect
        xor rax, rax;
        mov [rbx + 8], rax;                 // style = 0 (default)

        lea rdi, [rip + _wcm_clear_a_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call clear_draw;
        cmp rax, 0;
        jne wcm_fail_clear_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 26624;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 31: slot 29 -- CLEAR / style=1 at (72, 20, 8, 9).
        // ==================================================================
        lea rbx, [rip + _wcm_clear_b_spec];
        mov rax, 0x0009000800140048;
        mov [rbx + 0], rax;                 // rect
        mov rax, 1;
        mov [rbx + 8], rax;                 // style = 1 (custom)

        lea rdi, [rip + _wcm_clear_b_spec];
        lea rsi, [rip + _wcm_buffer];
        mov rdx, 30;
        mov rcx, 80;
        call clear_draw;
        cmp rax, 0;
        jne wcm_fail_clear_rc;

        lea rdi, [rip + _wcm_buffer];
        add rdi, 26752;
        call wcm_tile_or_scan;
        cmp rax, 0;
        je  wcm_fail_tile_or_guard;

        // ==================================================================
        // Phase 32: guard-row check. Walk row 9, row 19, row 29 (160
        // qwords per row = 80 cells x 2 qwords/cell) and assert every
        // qword is still zero. A single non-zero qword short-circuits
        // to the shared tile-or-guard sentinel.
        // ==================================================================
        // Row 9 (byte offset 11520 = (9 * 80) * 16).
        lea rbx, [rip + _wcm_buffer];
        add rbx, 11520;
        mov rcx, 160;
      wcm_g9_loop:
        cmp rcx, 0;
        je  wcm_g9_done;
        mov rax, [rbx + 0];
        cmp rax, 0;
        jne wcm_fail_tile_or_guard;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_g9_loop;
      wcm_g9_done:

        // Row 19 (byte offset 24320 = (19 * 80) * 16).
        lea rbx, [rip + _wcm_buffer];
        add rbx, 24320;
        mov rcx, 160;
      wcm_g19_loop:
        cmp rcx, 0;
        je  wcm_g19_done;
        mov rax, [rbx + 0];
        cmp rax, 0;
        jne wcm_fail_tile_or_guard;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_g19_loop;
      wcm_g19_done:

        // Row 29 (byte offset 37120 = (29 * 80) * 16).
        lea rbx, [rip + _wcm_buffer];
        add rbx, 37120;
        mov rcx, 160;
      wcm_g29_loop:
        cmp rcx, 0;
        je  wcm_g29_done;
        mov rax, [rbx + 0];
        cmp rax, 0;
        jne wcm_fail_tile_or_guard;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_g29_loop;
      wcm_g29_done:

        // ==================================================================
        // All 30 variants + guard rows passed.
        // ==================================================================
        xor rax, rax;
        pop rbx;
        ret;

      wcm_fail_block_rc:
        mov rax, 0xFFFFEDF0;
        pop rbx;
        ret;

      wcm_fail_paragraph_rc:
        mov rax, 0xFFFFEDF1;
        pop rbx;
        ret;

      wcm_fail_list_rc:
        mov rax, 0xFFFFEDF2;
        pop rbx;
        ret;

      wcm_fail_table_rc:
        mov rax, 0xFFFFEDF3;
        pop rbx;
        ret;

      wcm_fail_tabs_rc:
        mov rax, 0xFFFFEDF4;
        pop rbx;
        ret;

      wcm_fail_scrollbar_rc:
        mov rax, 0xFFFFEDF5;
        pop rbx;
        ret;

      wcm_fail_gauge_rc:
        mov rax, 0xFFFFEDF6;
        pop rbx;
        ret;

      wcm_fail_sparkline_rc:
        mov rax, 0xFFFFEDF7;
        pop rbx;
        ret;

      wcm_fail_barchart_rc:
        mov rax, 0xFFFFEDF8;
        pop rbx;
        ret;

      wcm_fail_chart_rc:
        mov rax, 0xFFFFEDF9;
        pop rbx;
        ret;

      wcm_fail_canvas_rc:
        mov rax, 0xFFFFEDFA;
        pop rbx;
        ret;

      wcm_fail_text_input_rc:
        mov rax, 0xFFFFEDFB;
        pop rbx;
        ret;

      wcm_fail_tree_rc:
        mov rax, 0xFFFFEDFC;
        pop rbx;
        ret;

      wcm_fail_calendar_rc:
        mov rax, 0xFFFFEDFD;
        pop rbx;
        ret;

      wcm_fail_clear_rc:
        mov rax, 0xFFFFEDFE;
        pop rbx;
        ret;

      wcm_fail_tile_or_guard:
        mov rax, 0xFFFFEDFF;
        pop rbx;
        ret;
      }
    }

}
