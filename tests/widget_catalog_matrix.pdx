  // ==========================================================================
  // wcm_tile_or_scan(base_ptr) -> u64
  //
  // Fixed-geometry OR-reduction over an 8-col x 9-row Cell tile (144
  // qwords). Row stride = 80 cols * 16 B = 1280 B (WCM_ROW_STRIDE).
  // Returns the OR of every qword in the tile; a zero return means
  // every cell in the tile is zero.
  //
  // Register plan: leaf, no nested calls. Push rbx (SysV callee-save;
  // rbx tracks the per-row base). rax = OR accumulator; r8 = column
  // qword load transit; r9 = row counter; r10 = per-row col cursor;
  // rcx = inner cell counter.
  //
  // Labels prefixed wcm_ts_ per docs fingerprint discipline.
  // ==========================================================================
  pub let wcm_tile_or_scan : (u64) -> u64 !{mem} @{} =
    fn (base_ptr: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "postui.M5-005 (postui#39): wcm_tile_or_scan reduces a fixed-geometry 8-col x 9-row Cell tile (144 qwords) via straight OR into rax. Register plan: leaf, push rbx (SysV callee-save; rbx tracks the per-row base). Outer y-loop counts 9 rows in r9, inner x-loop counts 8 cells in rcx and touches both qwords per cell via base+displacement addressing (mov r8, [r10+0]; or rax, r8; mov r8, [r10+8]; or rax, r8; add r10, 16). After each row, add rbx, 1280 (WCM_ROW_STRIDE = 80*16, imm32-safe) and re-seed r10 = rbx. Return rax. Every immediate (0, 8, 16, 1280, 8, 9) fits imm32; no test, no imul, no and reg,imm64. Effect !{mem} (144 qword loads).",
      block: {
        push rbx;
        mov rbx, rdi;                       // row-base cursor
        xor rax, rax;                       // OR accumulator
        mov r9, 9;                          // row counter
      wcm_ts_row_loop:
        cmp r9, 0;
        je  wcm_ts_done;
        mov r10, rbx;                       // per-row col cursor
        mov rcx, 8;                         // cells per row
      wcm_ts_col_loop:
        cmp rcx, 0;
        je  wcm_ts_row_next;
        mov r8, [r10 + 0];
        or  rax, r8;
        mov r8, [r10 + 8];
        or  rax, r8;
        add r10, 16;
        sub rcx, 1;
        jmp wcm_ts_col_loop;
      wcm_ts_row_next:
        add rbx, 1280;                      // WCM_ROW_STRIDE
        sub r9, 1;
        jmp wcm_ts_row_loop;
      wcm_ts_done:
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // widget_catalog_matrix_smoke() -> u64
  //
  // Runs the 30-variant matrix end-to-end. Phase shape:
  //
  //   Phase 0:  zero the 4800-qword shared buffer.
  //   Phase 0b: zero every shared aux slab (span, line, text) plus every
  //             slab that partial-writes single bytes (text_input
  //             buffers, canvas bitmaps).
  //   Phase 1:  build shared aux data (Span "X", Line, Text).
  //   Phase 2:  slot 0 -- block with border PLAIN.
  //   Phase 3:  slot 1 -- block without border (title stamps).
  //   Phase 4:  slot 2 -- paragraph wrap=NONE.
  //   Phase 5:  slot 3 -- paragraph wrap=WORD.
  //   Phase 6:  slot 4 -- list state=NULL.
  //   Phase 7:  slot 5 -- list state.selected=0.
  //   Phase 8:  slot 6 -- table with header.
  //   Phase 9:  slot 7 -- table without header.
  //   Phase 10: slot 8 -- tabs 1-tab.
  //   Phase 11: slot 9 -- tabs 3-tab mid-selected.
  //   Phase 12: slot 10 -- scrollbar Vertical.
  //   Phase 13: slot 11 -- scrollbar Horizontal.
  //   Phase 14: slot 12 -- gauge Bar.
  //   Phase 15: slot 13 -- gauge Line.
  //   Phase 16: slot 14 -- sparkline with 1 value.
  //   Phase 17: slot 15 -- sparkline value_count=0.
  //   Phase 18: slot 16 -- barchart 1 bar.
  //   Phase 19: slot 17 -- barchart 5 bars.
  //   Phase 20: slot 18 -- chart Line (2 points).
  //   Phase 21: slot 19 -- chart Scatter (1 point).
  //   Phase 22: slot 20 -- canvas with drawn line.
  //   Phase 23: slot 21 -- canvas cleared only.
  //   Phase 24: slot 22 -- text_input SingleLine.
  //   Phase 25: slot 23 -- text_input MultiLine.
  //   Phase 26: slot 24 -- tree leaf-only.
  //   Phase 27: slot 25 -- tree expanded.
  //   Phase 28: slot 26 -- calendar month=1.
  //   Phase 29: slot 27 -- calendar month=7.
  //   Phase 30: slot 28 -- clear style=0.
  //   Phase 31: slot 29 -- clear style=1.
  //   Phase 32: guard-row check (rows 9, 19, 29).
  //
  // Returns 0 on ALL passes. First failure short-circuits with the
  // widget-class sentinel; the smoke harness attributes variant A vs B
  // via the source location.
  //
  // Labels prefixed wcm_ per docs fingerprint discipline.
  // ==========================================================================
  pub let widget_catalog_matrix_smoke : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "postui.M5-005 (postui#39): widget_catalog_matrix_smoke drives all 30 (widget, variant) draw invocations against an 80x30 shared buffer laid out as 10x3 tiles (each 8x9 cells) with row-9/19/29 guard rows between tile rows. Same shape as M4-008 (boot_widget_catalog_smoke.pdx) scaled to a 2-variant-per-widget matrix. 1-push (rbx) = 8 B rounds SysV entry rsp%16==8 to 0, aligned for every nested call. Phase 0 zeros the shared buffer (4800 qwords) then zeros every fixture aux slab that is either shared across variants (span/line/text) or partial-written with mov_b (text_input buffers, canvas bitmaps); per-variant spec slabs are direct-store-overwritten in their setup phases and need no pre-zero. Phase 1 seeds shared aux: span_init(&_wcm_span_x, &_wcm_str_x, 1, 0); line_init(&_wcm_line_x, &_wcm_span_x, 1, 0); text_init(&_wcm_text_x, &_wcm_line_x, 1). Phases 2..31 walk each variant: setup spec (via spec_init helper OR direct-store), call widget_draw, check rc == 0 with jne to per-widget-class fail arm, then call wcm_tile_or_scan at the variant's tile byte offset and check the OR-accumulator is non-zero (je wcm_fail_tile_or_guard). Every packed rect literal (0x00090008xxxxxxxx) and every fail sentinel (0xFFFFEDFx) is > 0x7FFFFFFF -> movabs (10-byte mov reg, imm64), legal for mov. All variant-specific state (border_kind, wrap_mode, header_ptr, selected, orientation, kind, value_count, bar_count, mode, packed_flags, month, style) is stored via direct-store or spec_init. tabs 3-tab variant walks 3 spans that all point at the shared _wcm_str_x byte via a 3-slot span array _wcm_tabs_b_spans; each Span is span_init-composed inline via direct-store (ptr, byte_len, style). chart Line variant plots 2 points (fx(0), fx(0)) and (fx(0), fx(8)) with x_max=fx(8), y_max=fx(9) so the Bresenham path stamps a vertical column-0 line. chart Scatter variant plots 1 point at (fx(0), fx(0)) with x_max=fx(8), y_max=fx(9) -- inherits M4-008's scatter shape. canvas LINE variant runs canvas_clear + canvas_line((fx(0), fx(0)) -> (fx(15), fx(17))) + canvas_draw; canvas CLR variant runs canvas_clear + canvas_draw only (canvas_draw stamps every cell with the empty-braille glyph U+2800 = 0x0080A0E2, non-zero). text_input SingleLine and MultiLine each pre-stamp 'X' via mov_b at buffer[0] then compose the spec via text_input_spec_init(rect, buffer_ptr, cap=16, buffer_len_and_cursor=0x0000000100000001 (imm32-safe), scroll_and_mode = 0 for SL, 1 for ML via mov). tree leaf variant direct-stores a single TreeNode(label='X', label_len=1, children_ptr=0, packed_flags=0); tree expanded variant direct-stores a root TreeNode(label='X', label_len=1, children_ptr=&_wcm_tree_b_child, packed_flags=0x8000000000000001 via movabs -- bit 63 = expanded, child_count = 1) and a child TreeNode(label='X', label_len=1, children_ptr=0, packed_flags=0). calendar variants differ only in month field (1 vs 7). clear variants differ only in style field (0 vs 1). Phase 32 guard-row check: three separate segments at byte offsets 11520 (row 9), 24320 (row 19), 37120 (row 29). Each segment: lea rbx, [_wcm_buffer]; add rbx, offset; mov rcx, 160 (80 cells x 2 qwords); loop mov rax, [rbx+0]; cmp rax, 0; jne wcm_fail_tile_or_guard; add rbx, 8; sub rcx, 1; jmp. Success: xor rax, rax; pop rbx; ret. Each fail arm: mov rax, 0xFFFFEDFx via movabs (imm > 0x7FFFFFFF; legal for mov); pop rbx; ret. Every immediate that reaches cmp (0, 1, 2, 3, 4, 5, 7, 8, 10, 16, 30, 40, 50, 80, 100, 160, 2026, 4800 -- plus every byte offset 128, 256, ..., 26752, 11520, 24320, 37120) fits imm32; every immediate in shift/add contexts fits imm32 similarly. Every large constant (packed rects, Fixed64 constants, buffer_len_and_cursor 0x0000000100000001, tree packed_flags 0x8000000000000001, fail sentinels 0xFFFFEDFx) is loaded via mov reg, imm64 (movabs, legal for mov). No test, no imul, no and, no cmp reg, imm > 0x7FFFFFFF, no cmp reg, [mem]. Every callee resolves via paideia-as's flat ELF symbol namespace. Effect !{mem} covers every fixture store and buffer readback. Labels prefixed wcm_ per docs fingerprint discipline.",
      block: {
        push rbx;

        // ==================================================================
        // Phase 0: zero the shared buffer (4800 qwords).
        // ==================================================================
        xor rax, rax;
        lea rbx, [rip + _wcm_buffer];
        mov rcx, 4800;
      wcm_zbuf_loop:
        cmp rcx, 0;
        je  wcm_zbuf_done;
        mov [rbx + 0], rax;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_zbuf_loop;
      wcm_zbuf_done:

        // ==================================================================
        // Phase 0b: zero every aux slab that is either shared across
        // variants (span/line/text) or partial-written with mov_b
        // (text_input buffers, canvas bitmaps).
        // ==================================================================
        xor rax, rax;
        lea rbx, [rip + _wcm_span_x];
        mov rcx, 3;
      wcm_zspan_loop:
        cmp rcx, 0;
        je  wcm_zspan_done;
        mov [rbx + 0], rax;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_zspan_loop;
      wcm_zspan_done:

        lea rbx, [rip + _wcm_line_x];
        mov rcx, 3;
      wcm_zline_loop:
        cmp rcx, 0;
        je  wcm_zline_done;
        mov [rbx + 0], rax;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_zline_loop;
      wcm_zline_done:

        lea rbx, [rip + _wcm_text_x];
        mov rcx, 2;
      wcm_ztext_loop:
        cmp rcx, 0;
        je  wcm_ztext_done;
        mov [rbx + 0], rax;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_ztext_loop;
      wcm_ztext_done:

        lea rbx, [rip + _wcm_ti_a_buffer];
        mov rcx, 2;
      wcm_ztiabuf_loop:
        cmp rcx, 0;
        je  wcm_ztiabuf_done;
        mov [rbx + 0], rax;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_ztiabuf_loop;
      wcm_ztiabuf_done:

        lea rbx, [rip + _wcm_ti_b_buffer];
        mov rcx, 2;
      wcm_ztibbuf_loop:
        cmp rcx, 0;
        je  wcm_ztibbuf_done;
        mov [rbx + 0], rax;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_ztibbuf_loop;
      wcm_ztibbuf_done:

        lea rbx, [rip + _wcm_canvas_a_bitmap];
        mov rcx, 9;
      wcm_zcvsa_loop:
        cmp rcx, 0;
        je  wcm_zcvsa_done;
        mov [rbx + 0], rax;
        add rbx, 8;
        sub rcx, 1;
        jmp wcm_zcvsa_loop;
      wcm_zcvsa_done:

        lea rbx, [rip + _wcm_canvas_b_bitmap];
        mov rcx, 9;
      wcm_zcvsb_loop:
        cmp rcx, 0;
